@page "/settings"
@using TCalcCore.Engine
@inject TourcalcEngine engine

@inject UiModeService uiMode

@inject IJSRuntime JsRuntime

@implements IDisposable

@{
    engine.SendMessage("Title", "Settings");
    engine.SendMessage("Tour", null);
}

@if (uiMode.IsNew)
{
    <div class="tcn-section">
        <div class="tcn-section-title">Interface</div>
        <div class="tcn-card" style="padding: 14px;">
            <div class="tcn-row" style="justify-content: space-between;">
                <div>
                    <div style="font-weight: 650;">Look and feel</div>
                    <div style="font-size: 12.5px; color: var(--tcn-muted);">
                        The classic interface keeps every legacy control; the new one is the redesigned, mobile-first view.
                    </div>
                </div>
                <UiModeSwitch Compact="false" Light="true" />
            </div>
        </div>
    </div>

    <div class="tcn-section">
        <div class="tcn-section-title">App</div>
        <div class="tcn-card" style="padding: 14px;">
            <div class="tcn-row" style="justify-content: space-between;">
                <div class="tcn-settext">
                    <div class="tcn-setname">Version</div>
                    <div class="tcn-setdesc">Checks the server for a newer build. An Update button appears in the header if there is one.</div>
                </div>
                <button type="button" class="tcn-btn" @onclick=@(() => JsRuntime.InvokeVoidAsync("window.manualCheckRegistration"))>
                    Check for updates
                </button>
            </div>
        </div>
    </div>

    <div class="tcn-section">
        <div class="tcn-section-title">Help</div>
        <a class="tcn-card tcn-helplink" href="/help">
            <TcIcon Name="help" />
            <div class="tcn-settext">
                <div class="tcn-setname">How Tourcalc counts</div>
                <div class="tcn-setdesc">
                    What a weight is, why a total can be smaller than the sum of the expenses,
                    what “uncounted” means, and every other word on screen.
                </div>
            </div>
        </a>
    </div>

    <SettingsForm Settings=@settings
                  OnSave=@(EventCallback.Factory.Create<UISettings>(this, async (s) => await engine.SetUISettings(s))) />

}
else
{
    <h3>UI Settings</h3>

    <div style="margin-bottom: 8px;">
        Interface: <UiModeSwitch Compact="false" Light="true" />
    </div>

    <Button @onclick=@(() => JsRuntime.InvokeVoidAsync("window.manualCheckRegistration"))>Check Update</Button>

    <DynaForm Item=@settings
              OnSave=@(async (s) => {
                        await engine.SetUISettings(s);
                    })
    />
}

@code {
    private UISettings settings = new UISettings();
    protected override async Task OnInitializedAsync()
    {
        uiMode.OnChanged += OnUiModeChanged;
        settings = await engine.GetUISettings();
    }
    public void Dispose()
    {
        uiMode.OnChanged -= OnUiModeChanged;
    }
    private void OnUiModeChanged() => _ = InvokeAsync(StateHasChanged);
}
