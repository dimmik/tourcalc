@page "/tour/{tourId}"
@page "/tour/{tourId}/persons"
@page "/tour/{tourId}/spendings"

@implements IDisposable

@using TCalc.Logic
@using TCBlazor.Client.Components
@using Microsoft.AspNetCore.WebUtilities

@using TCalcCore.Engine
@inject TourcalcEngine engine

@inject TCalcCore.Network.EnrichedHttpClient hClient;
@inject ITokenStorage tokenStorage;

@inject IJSRuntime JsRuntime
@inject NavigationManager NavManager

@inject UiModeService uiMode


@if (tour == null)
{
    @if (uiMode.IsNew)
    {
        <div class="tcn-loading"><span class="tcn-spin"><TcIcon Name="refresh" /></span> Loading the tour…</div>
    }
    else
    {
        <span>Tour loading...</span>
    }
}
else if (uiMode.IsNew)
{
    engine.SendMessage("Title", tour.Name);
    engine.SendMessage("Tour", tour);
    <PageTitle>@tour.Name</PageTitle>
    <TourPageNew Tour=@(tourLocal ?? tour)
                 RawTour=@tour
                 Settings=@settings
                 IsFresh=@isFresh
                 StoredDt=@storedDt
                 SelectedCurrency=@curr
                 OnCurrencyChanged=@(EventCallback.Factory.Create<Currency?>(this, OnDisplayCurrencyChanged))
                 AddModal=@_spendingAddInModal
                 InitialSection=@InitialSection
                 GetDefaultPayer=@GetDefaultFromGuid />
}
else
{
    engine.SendMessage("Title", tour.Name);
    engine.SendMessage("Tour", tour);
    <PageTitle>@tour.Name</PageTitle>
    <TourHeader tour="tourLocal" isFresh="isFresh" storedDt="storedDt"/>
    <div style="width: 100%; display: table">
        <div style="display: table-cell; width: 50%; align-content: flex-start; text-align: start; white-space: nowrap;">
            <!--Persons-->
            <b id=@GetId("persons")>Persons [@tour.Persons.Count]</b>
            <Button Type="ButtonType.Primary" Ghost Size="ButtonSize.Small" @onclick=@(() => ShowPersons = !ShowPersons)>@(ShowPersons ? "hide" : "show")</Button>
                @if (tour?.IsMultiCurrency() ?? false)
                {
                <!-- choose local currency -->
                <Select @bind-Value=@(curr)
                    TItemValue="Currency"
                    TItem="Currency"
                    LabelName="@nameof(Currency.Name)"
                    AllowClear=@true
                    Style="width: 80px;"
                    DataSource="tour?.Currencies ?? new Currency[0]"
                    OnSelectedItemChanged="() => tourLocal = GetTourInCurrency(tourLocal??new())"
                    OnClearSelected="() => {curr = tour?.Currency; tourLocal = GetTourInCurrency(tourLocal??new());}"
                    IgnoreItemChangesLeadsToException="false" />
                }
        </div>
        <div style="display: table-cell; width: 50%; align-content: flex-end; text-align: end;">
            <a href=@GetHref("spendings")>Spendings</a>
            <Button Type="ButtonType.Primary" Size="ButtonSize.Small" Danger=@true @onclick=@(async () => _spendingAddInModal.OpenModal(await GetDefaultFromGuid()))>SPEND</Button>
        </div>
    </div>
    @if (ShowPersons)
    {
        <TourPersonsComponent 
        tour=@tourLocal
        OnPersonDelete=@(async (p) => {
            _ = engine.RequestDeletePerson(tour?.Id, p);
        })
        OnPersonEdit=@(async (p) => {
            _ = engine.RequestEditPerson(tour?.Id, p);
        })
        OnPersonAdd=@(async (p) => {
            // Person is being added both on server and in local. We need to ensure ID is consistent (otherwise if we add child - it will catch wrong parentId).
            p.GUID = IdHelper.NewId();
            _ = engine.RequestAddPerson(tour?.Id, p);
        })
        SpendingAddInModal="_spendingAddInModal"
        />
    }
    <!--Spendings-->
    <div style="width: 100%; display: table">
    <div style="display: table-cell; width: 40%; align-content: flex-start; text-align: start;">
        <b id=@GetId("spendings")>Spendings [@(tour?.Spendings?.Where(s => !s.Planned)?.Count()??0)]</b>
            <Button Type="ButtonType.Primary" Ghost Size="ButtonSize.Small" @onclick=@(() => ShowSpendings = !ShowSpendings)>@(ShowSpendings ? "hide" : "show")</Button>
    </div>
    <div style="display: table-cell; width: 60%; align-content: flex-end; text-align: end;">
        <a href=@GetHref("persons")>Persons</a>
        <Button Type="ButtonType.Primary" Size="ButtonSize.Small" Danger=@true @onclick=@(async () => _spendingAddInModal.OpenModal(await GetDefaultFromGuid()))>SPEND</Button>
    </div>
    </div>
    @if (ShowSpendings){
        <TSpComponent 
            Tour=@tourLocal
            ShowPlanned=@ShowPlannedSpendings
            OnToggleShowPlanned=@(() => {
                // TODO works slow. Think about it
                ShowPlannedSpendings = !ShowPlannedSpendings;
                StateHasChanged();
            })
            OnSpendingDelete=@(async (s) => {
                _ = engine.RequestDeleteSpending(tour?.Id, s);
            })
        >
            <EditActionTemplate Context="s">
                    @if (s.Planned)
                    {
                    <Button Danger Size="ButtonSize.Small" @onclick=@(async () => {
                            bool confirmed = await JsRuntime.InvokeAsync<bool>("confirm", $"Add planned '{s.Description}' : {s.AmountInCents}?");
                            if (confirmed)
                            {
                                var ss = s.SafeClone<Spending>();
                                ss.Type = "";
                                ss.Color = ss.Description.StartsWith("X") ? "lightgreen" : "lightgray";
                                _ = engine.RequestAddSpending(tour?.Id, ss);
                            }
                        })>+</Button>
                    }
                    else
                    {
                        <SpendingEditInModal spending=@s tour=@tour @key=@($"sp_ed_mod_{s.GUID}")/>
                    }
            </EditActionTemplate>
        </TSpComponent>
    }
}
<AnchorNavigation />
<SpendingAddInModal @ref="_spendingAddInModal" tour="tour" />
@code {
    [Parameter]
    public string? TourId { get; set; }

    private bool ShowPlannedSpendings = false;
    private bool initialized = false;

    private bool ShowPersons = true;
    private bool ShowSpendings = true;

    public Tour? tour = null;
    public Tour? tourLocal = null;
    private Currency? curr = null;
    private bool isFresh = false;
    private DateTimeOffset storedDt = DateTimeOffset.Now;

    private UISettings settings = new UISettings();
    public bool isSubscribed = false;
    public bool? subscriptionChecked = null;

    private SpendingAddInModal _spendingAddInModal = new();
    private bool _modalOpened = false;

    protected override async Task OnInitializedAsync()
    {
        settings = await engine.GetUISettings();

        // subscribe to tour loaded event
        engine.onTourLoaded += OnTourLoaded;
        uiMode.OnChanged += OnUiModeChanged;
        // send command to load tour with certain id
        _ = engine.RequestTourLoad(TourId);
    }

    private void OnUiModeChanged() => _ = InvokeAsync(StateHasChanged);

    private Task OnDisplayCurrencyChanged(Currency? c)
    {
        curr = c ?? tour?.Currency;
        tourLocal = GetTourInCurrency(tour?.SafeClone<Tour>() ?? new());
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task<string?> GetDefaultFromGuid()
    {
        var whoAmI = await engine.GetWhoAmI();
        if (!string.IsNullOrWhiteSpace(whoAmI) && tour?.Persons.Any(p => p.GUID == whoAmI) == true)
        {
            return whoAmI;
        }

        // Both kinds of generated row are recognised by their description and both carry an
        // empty Type (TourCalculator writes Type = "" for them, and so does "Mark paid"), so
        // the old `Type != "Family"` test never matched and a family settlement could become
        // the "last expense" - putting its participant into the form as the default payer.
        var lastSpending = tour?.Spendings
            .Where(s => !s.Planned)
            .Where(s => !(s.Description ?? "").StartsWith("X"))
            .Where(s => !(s.Description ?? "").StartsWith("Family"))
            .OrderByDescending(s => s.SpendingDate)
            .FirstOrDefault();

        return lastSpending?.FromGuid;
    }

    public void Dispose()
    {
        engine.onTourLoaded -= OnTourLoaded;
        uiMode.OnChanged -= OnUiModeChanged;
    }
    private Tour GetTourInCurrency(Tour t)
    {
        if (curr == null) return t;
        var calc = new TourCalculator(t, curr);
        return calc.SuggestFinalPayments();
    }
    private async Task OnTourLoaded(Tour t, bool isFromServer, DateTimeOffset updated)
    {
        isFresh = isFromServer;
        storedDt = updated;
        if (curr == null) // only if we have not used the curr yet
        {
            curr = t.Currency;
        }
        tour = t;
        tourLocal = tour.SafeClone<Tour>();
        tourLocal = GetTourInCurrency(tourLocal);
        if (!initialized)
        {
            ShowPlannedSpendings = (tour?.IsFinalizing ?? false) && !(tour?.IsArchived ?? false);
            initialized = true;
        }
        StateHasChanged();

        if (_modalOpened) return;
        var uri = new Uri(NavManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("action", out var action) && action == "addspending")
        {
            _modalOpened = true;
            var addAnother = query.TryGetValue("addanother", out var addanother) && addanother == "true";
            _spendingAddInModal.OpenModal(await GetDefaultFromGuid(), addAnother);
        }
    }
    private Task OnTourStored(bool storedOnServer)
    {
        if (storedOnServer)
        {
            _ = engine.RequestTourLoad(TourId, forceLoadFromServer: true);
        } else
        {
            _ = engine.RequestTourLoad(TourId, forceLoadFromServer: false, forceLoadFromLocalStorage: true);
        }
        StateHasChanged();
        return Task.CompletedTask;
    }
    /// <summary>Last path segment of /tour/{id}/persons | /tour/{id}/spendings, empty for the plain tour route.</summary>
    private string InitialSection
    {
        get
        {
            var path = new Uri(NavManager.Uri).AbsolutePath.TrimEnd('/');
            var last = path.Substring(path.LastIndexOf('/') + 1);
            return last is "persons" or "spendings" ? last : "";
        }
    }

    string GetId(string l) => $"{l}";
    string GetHref(string l) => $"/tour/{TourId}#" + GetId(l);
}
