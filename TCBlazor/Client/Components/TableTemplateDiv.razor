@typeparam TItem
@using System.Diagnostics.CodeAnalysis

<div class="grid-table" style="grid-template-columns: repeat(@(cols),auto);">
    @if (TableHeader is not null)
    {
        <div class="row">@TableHeader</div>
    }
    @{
        var item_index = 0;
    }
    @foreach (var item in (Items ?? Enumerable.Empty<TItem>()))
    {
        if (RowTemplate is not null)
        {
            if (ConditionalItemIdxIncrement(item, item_index))
            {
                item_index += 1;
            }
            <div class="row">@RowTemplate((item, item_index))</div>
        }
    }
    @if (!(Items?.Any() ?? false))
    {
        if (NoDataRowTemplate is not null){
            <div class="row">@NoDataRowTemplate</div>
        } else {
            <div class="row">
                <div class="grid-cell-no-data">No Data</div>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public RenderFragment? TableHeader { get; set; }

    [Parameter]
    public RenderFragment<(TItem, int)>? RowTemplate { get; set; }

    [Parameter]
    public RenderFragment? NoDataRowTemplate { get; set; } = null;

    [Parameter, AllowNull]
    public IEnumerable<TItem> Items { get; set; }

    [Parameter]
    public int cols { get; set; } = 3;

    [Parameter]
    public int TopPadding { get; set; } = 0;

    [Parameter]
    public bool StickyHeader { get; set; } = false;

    [Parameter]
    public string HeaderBgColor { get; set; } = "white";

    [Parameter]
    public Func<TItem, int, bool> ConditionalItemIdxIncrement { get; set; } = (i, idx) => true;

}