@namespace TCBlazor.Client.Components
@typeparam TValue
<input class="tcn-input @(Is(Size, "small") ? "tcn-input-sm" : "")"
       type="@(string.IsNullOrEmpty(Type) ? "text" : (Is(Type, "number") ? "number" : Type))"
       style="@Style"
       placeholder="@Placeholder"
       value="@Value"
       @oninput=@Changed
       @attributes="Extra" />

@code {
    [Parameter] public TValue Value { get; set; }
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }
    [Parameter] public string Type { get; set; } = "";
    [Parameter] public string Size { get; set; } = "";
    [Parameter] public string Style { get; set; } = "";
    [Parameter] public string Placeholder { get; set; } = "";

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object> Extra { get; set; }

    private static bool Is(string v, string n)
        => !string.IsNullOrEmpty(v) && v.EndsWith(n, StringComparison.OrdinalIgnoreCase);

    private async Task Changed(ChangeEventArgs e)
    {
        var text = e.Value?.ToString() ?? "";
        TValue converted;
        try
        {
            converted = (TValue)Convert.ChangeType(text, typeof(TValue));
        }
        catch
        {
            return;   // half-typed numbers are not an error, just not a value yet
        }
        Value = converted;
        if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(Value);
    }
}
