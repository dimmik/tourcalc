@namespace TCBlazor.Client.Components
@* AntDesign's <Switch>, as a checkbox wearing the toggle the new interface already has. *@
<label class="tcn-toggle" title="@(Value ? CheckedChildren : UnCheckedChildren)">
    <input type="checkbox" checked="@Value" @onchange=@Toggle disabled="@Disabled" />
    <span></span>
</label>

@code {
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public string CheckedChildren { get; set; } = "";
    [Parameter] public string UnCheckedChildren { get; set; } = "";
    [Parameter] public string Size { get; set; } = "";
    [Parameter] public bool Disabled { get; set; }

    private async Task Toggle(ChangeEventArgs e)
    {
        Value = (bool)(e.Value ?? false);
        if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(Value);
    }
}
