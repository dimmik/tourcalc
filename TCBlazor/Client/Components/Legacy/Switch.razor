@namespace TCBlazor.Client.Components
@* AntDesign's <Switch>, as a checkbox wearing the toggle the new interface already has. *@
@* Ant drew the on/off word inside the track; there is no room for that in the
   toggle the new interface uses, so the word stands next to it instead. *@
<span class="tc-legacy-switch" style="@Style" @attributes="Extra">
    <label class="tcn-toggle" title="@Label">
        <input type="checkbox" checked="@Value" @onchange=@Toggle disabled="@Disabled" />
        <span></span>
    </label>
    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="tc-legacy-switch-label">@Label</span>
    }
</span>

@code {
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public string CheckedChildren { get; set; } = "";
    [Parameter] public string UnCheckedChildren { get; set; } = "";
    [Parameter] public string Size { get; set; } = "";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Style { get; set; } = "";
    [Parameter] public EventCallback<bool> OnChange { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object> Extra { get; set; }

    private string Label => Value ? CheckedChildren : UnCheckedChildren;

    private async Task Toggle(ChangeEventArgs e)
    {
        Value = (bool)(e.Value ?? false);
        if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(Value);
        if (OnChange.HasDelegate) await OnChange.InvokeAsync(Value);
    }
}
