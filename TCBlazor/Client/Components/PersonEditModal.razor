@using TCalc.Domain
@using TCalcCore.Engine

@using System.ComponentModel.DataAnnotations

@inject TourcalcEngine engine

<TcModal Title="@(IsAdding ? "Add Person" : $"Edit {Person?.Name}")"
       Visible="@Visible"
       OnCancel="@(async () => await HandleCancel(null))">
    <div class="tcn-field">
        <div class="tcn-label">Name</div>
        <input class="tcn-input" type="text" @bind-value="_person.Name" @bind-value:event="oninput" />
    </div>
    <div class="tcn-field">
        <div class="tcn-label">Weight</div>
        <input class="tcn-input" type="number" @bind-value="_person.Weight" />
    </div>
    <div class="tcn-field">
        <div class="tcn-label">Parent</div>
        @* a plain select: AntDesign's had a clear button, which "pays for themselves" is *@
        <select class="tcn-input" @bind="ParentId">
            <option value="">pays for themselves</option>
            @foreach (var p in Tour?.Persons.Where(p => p.GUID != _person.GUID && string.IsNullOrWhiteSpace(p.ParentId)) ?? new List<Person>())
            {
                <option value="@p.GUID">@p.Name</option>
            }
        </select>
    </div>
    <div style="text-align: right;">
        <button type="button" class="tcn-btn" @onclick=@(() => HandleCancel(null))>Cancel</button>
        <button type="button" class="tcn-btn tcn-btn-primary" @onclick=@(() => HandleOk(null))>Save</button>
    </div>
</TcModal>

@code {
    [Parameter]
    public Tour? Tour { get; set; }

    [Parameter]
    public Person? Person { get; set; }

    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback<Person> OnOk { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private Person _person = new();
    private bool IsAdding => string.IsNullOrEmpty(Person?.GUID) || Person?.GUID == "New";

    protected override void OnParametersSet()
    {
        if (Person != null)
        {
            _person = Person.SafeClone<Person>();
        }
        else
        {
            _person = new Person();
        }
    }

    private async Task HandleOk(MouseEventArgs e)
    {
        await OnOk.InvokeAsync(_person);
    }

    private async Task HandleCancel(MouseEventArgs e)
    {
        await OnCancel.InvokeAsync(null);
    }

    /// <summary>
    /// Empty means nobody pays for them. The domain stores that as null, and a select
    /// cannot carry null - so the empty option is translated at this boundary.
    /// </summary>
    private string ParentId
    {
        get => _person.ParentId ?? "";
        set => _person.ParentId = string.IsNullOrEmpty(value) ? null : value;
    }
}
