@inject UiModeService uiMode

@if (Single)
{
    @* one small button that steps through the three interfaces - for the cramped classic header *@
    <button type="button" class="tcn-uiswitch-single" title="@NextTitle"
            @onclick=@(() => Set(Next))>
        ⇄ @Label(Next)
    </button>
}
else
{
    @* segmented control. The header offers only New / Mini - the everyday choice
       between roomy and dense; Classic is an escape hatch reached from Settings,
       so it is not on the bar you look at all day. Settings passes IncludeClassic
       and shows all three. *@
    <span class="tcn-uiswitch @(Light ? "tcn-uiswitch-light" : "")" title="Switch the interface">
        @foreach (var m in Shown)
        {
            <button type="button"
                    class="tcn-uiswitch-opt @(uiMode.Mode == m ? "is-active" : "")"
                    title="@Hint(m)"
                    @key=@m
                    @onclick=@(() => Set(m))>
                @Label(m)
            </button>
        }
    </span>
}

@code {
    [Parameter]
    public bool Compact { get; set; } = true;

    /// <summary>Use the light-background variant (for the settings page).</summary>
    [Parameter]
    public bool Light { get; set; } = false;

    /// <summary>Render a single cycling button instead of the multi-option control.</summary>
    [Parameter]
    public bool Single { get; set; } = false;

    /// <summary>
    /// Whether the segmented control offers Classic. Off in the header (New / Mini only),
    /// on in Settings, which is the one place the classic interface is chosen from.
    /// </summary>
    [Parameter]
    public bool IncludeClassic { get; set; } = false;

    private static readonly UiMode[] Order = new[] { UiMode.Full, UiMode.Mini, UiMode.Classic };

    /// <summary>The options the segmented control draws.</summary>
    private UiMode[] Shown => IncludeClassic ? Order : new[] { UiMode.Full, UiMode.Mini };

    /// <summary>What the cycling button moves to - the full order, wrapping round.</summary>
    private UiMode Next => Order[(Array.IndexOf(Order, uiMode.Mode) + 1) % Order.Length];

    private string NextTitle => $"Switch to the {Hint(Next).ToLowerInvariant()}";

    // "Full" rather than "New": next to Mini the question is how much room a thing
    // gets, not how old the design is - and in the header, where Classic is not on
    // offer, "New" named a contrast the reader could not see. The stored value stays
    // "new", so nobody's saved choice is disturbed.
    private string Label(UiMode m) => m switch
    {
        UiMode.Mini => "Mini",
        UiMode.Classic => Compact ? "Old" : "Classic",
        _ => "Full",
    };

    private static string Hint(UiMode m) => m switch
    {
        UiMode.Mini => "Mini interface - one line per thing, for a small screen or a slow device",
        UiMode.Classic => "Classic interface",
        _ => "Full interface - the roomy view",
    };

    private async Task Set(UiMode m)
    {
        await uiMode.SetMode(m);
    }
}
