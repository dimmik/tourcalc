@using TCalcCore.Engine
@using TCalc.Logic
@using TCalc.Domain
@using AntDesign
@inject TourcalcEngine engine

@inject IJSRuntime JsRuntime
@inject NavigationManager NavManager

@implements IDisposable

<div>
    <Button Type="@ButtonType.Primary" OnClick="@(() => ShowModal(new Person { GUID = "New" }))">
        <Icon Type="plus" /> Add Person
    </Button>
</div>

<TableTemplateDiv cols="@(ShowWeightSpentReceived ? 5 : 2)"
                  Items="@_personsForRender"
                  Context="personItem"
                  TopPadding="30"
                  ConditionalItemIdxIncrement="@((p, idx) => p.Metadata != "Adding")">
    <TableHeader>
        <div class="grid-header">
            Name
            @if (ShowWeightSpentReceived)
            {
                <Button Size="ButtonSize.Small" @onclick=@(() => {ShowWeightSpentReceived = false; IsSpendReceivedSwitchedManually = true;})>&lt;</Button>
            }
            else
            {
                <Button Size="ButtonSize.Small" @onclick=@(() => {ShowWeightSpentReceived = true; IsSpendReceivedSwitchedManually = true;})>&gt;</Button>
            }
        </div>
        @if (ShowWeightSpentReceived)
        {
            <div class="grid-header">Weight</div>
            <div class="grid-header">Spent</div>
            <div class="grid-header">Received</div>
        }
        <div class="grid-header">
            @{
                var debtor = CalcUtilities.GetDebtor(Tour);
            }
            @if (debtor.p != null)
            {
                <NoOp>
                    DEBTOR
                    <b style="font-weight: bolder; color: red">
                        @(debtor.p?.Name ?? "N/A")
                        <span style="color:green"> @debtor.debt @Tour?.CurrencyNameEmptyIfSingleCurrency() </span>
                    </b>
                </NoOp>
            }
            else
            {
                <NoOp>Debt</NoOp>
            }
        </div>
    </TableHeader>
    <RowTemplate>
        @{
            var person = personItem.Item1;
            var p_idx = personItem.Item2;
            var familyId = familyMapping[person].familyId;
            var first = familyMapping[person].firstInFamily;
            var last = familyMapping[person].lastInFamily;
            int idx = familyMapping[person].idx;
            var fClass = familyId % 2 == 0 ? "family-even-row" : "family-odd-row";
            var topRoundClass = "";
            var bottomRoundClass = "";
            if (first)
            {
                fClass += " top-thick-border";
                topRoundClass = " top-left-round";
            }
            if (last)
            {
                bottomRoundClass = " bottom-left-round";
            }
            var veryLastClass = "";
            var veryLastPerson = idx == _personsForRender.Count();
            if (veryLastPerson)
            {
                veryLastClass = " bottom-thick-border";
            }
        }
        <div class="grid-cell @fClass left-thick-border @topRoundClass @bottomRoundClass @veryLastClass">
            <PersonNameAndActions @key=@($"pna_{person.GUID}")
                                  idx="idx"
                                  person="person"
                                  tour="Tour"
                                  OnPersonDelete="OnPersonDelete"
                                  OnPersonEdit="@((p) => ShowModal(p))"
                                  OnPersonSpend=@((p) => {
                                NavManager.NavigateTo($"tour/{Tour?.GUID ?? "000"}/spending/add/{p.GUID}");
                                return Task.CompletedTask;
                            }) />
        </div>
        @if (ShowWeightSpentReceived)
        {
            <div class="grid-cell @fClass @veryLastClass">
                <div style="height: 100%; width: 100%; display:flex;align-items:center;justify-content:center;">
                    @person.Weight
                </div>
            </div>
            <div class="grid-cell @fClass @veryLastClass"><PersonSpentInfo tour=@Tour person="person" @key=@($"psi_{person.GUID}") /></div>
            <div class="grid-cell @fClass @veryLastClass"><PersonReceivedInfo tour=@Tour person="person" @key=@($"pri_{person.GUID}") /></div>
        }
        <div class="grid-cell @fClass @veryLastClass">
            <PersonDebt @key=@($"debt_{person.GUID}")
                        debt="Debt(person)"
                        person="person"
                        tour=@(Tour ?? new Tour())
                        minMeaningfulAmount=@(Tour?.GetAmountInCurrentCurrencyFromMinValued(settings.MinimumMeaningfulDebt) ?? 0) />
        </div>
    </RowTemplate>
</TableTemplateDiv>

<PersonEditModal Person="@_personToEdit"
                 Tour="@Tour"
                 Visible="@_isModalVisible"
                 OnOk="HandleModalOk"
                 OnCancel="HandleModalCancel" />

@code {
    [Parameter]
    public Tour? Tour { get; set; } = null;

    [Parameter]
    public Func<Person, Task> OnPersonEdit { get; set; } = p => Task.CompletedTask;
    [Parameter]
    public Func<Person, Task> OnPersonAdd { get; set; } = p => Task.CompletedTask;
    [Parameter]
    public Func<Person, Task> OnPersonDelete { get; set; } = p => Task.CompletedTask;

    private bool _isModalVisible = false;
    private Person _personToEdit = new();

    bool ShowWeightSpentReceived = true;
    bool IsSpendReceivedSwitchedManually = false;
    int tableColspan => ShowWeightSpentReceived ? 5 : 2;

    int windowWidth = 0;

    private UISettings settings = new UISettings();

    private List<Person> _personsForRender = new List<Person>();

    protected override async Task OnInitializedAsync()
    {
        settings = await engine.GetUISettings();
        await OnResize();
        BrowserResizeService.OnResize += OnResize;
    }

    private async Task OnResize()
    {
        if (settings.Collapse_Columns_In_Person_List_On_Smaller_Screen && !IsSpendReceivedSwitchedManually)
        {
            var dim = await JsRuntime.InvokeAsync<BrowserDimension>("getDimensions");
            windowWidth = dim.Width;
            var newShowWeightSpentReceived = windowWidth > settings.Smaller_Screen_Width;
            if (newShowWeightSpentReceived != ShowWeightSpentReceived)
            {
                ShowWeightSpentReceived = newShowWeightSpentReceived;
                StateHasChanged();
            }
        }
    }

    public void Dispose()
    {
        BrowserResizeService.OnResize -= OnResize;
    }

    private Dictionary<Person, (int familyId, bool firstInFamily, bool lastInFamily, int idx)> familyMapping = new();

    protected override void OnParametersSet()
    {
        _personsForRender = GetSortedTourPersons().ToList();
        int fid = 0;
        Person? prevPerson = null;
        int index = 0;
        foreach (var p in _personsForRender)
        {
            index++;
            bool first = false;
            if (string.IsNullOrWhiteSpace(p.ParentId))
            {
                first = true;
                fid++;
                if (prevPerson != null)
                {
                    var (ffid, fff, fl, idx) = familyMapping[prevPerson];
                    familyMapping[prevPerson] = (ffid, fff, true, idx); // last in family1
                }
            }
            familyMapping[p] = (fid, first, false, index);
            prevPerson = p;
        }
        if (prevPerson != null) // for the very last person
        {
            var (ffid1, fff1, fl1, idx1) = familyMapping[prevPerson];
            familyMapping[prevPerson] = (ffid1, fff1, true, idx1); // last in family
        }
    }

    private long Debt(Person p)
    {
        if (Tour == null) return 0;
        // round to MinimumMeaningfulDebt
        return Math.Abs(p.Debt()) > Tour.GetAmountInCurrentCurrencyFromMinValued(settings.MinimumMeaningfulDebt) ? p.Debt() : 0;
    }

    private IEnumerable<Person> GetSortedTourPersons()
    {
        return Tour?.Persons?.SortedByNameAndDependency() ?? Enumerable.Empty<Person>();
    }

    private Task ShowModal(Person person)
    {
        _personToEdit = person;
        _isModalVisible = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task HandleModalOk(Person person)
    {
        if (string.IsNullOrWhiteSpace(person.Name))
        {
            await JsRuntime.InvokeVoidAsync("alert", "Person name should not be blank");
            return;
        }

        if (person.GUID == "New")
        {
            await OnPersonAdd(person);
        }
        else
        {
            await OnPersonEdit(person);
        }
        _isModalVisible = false;
    }

    private Task HandleModalCancel()
    {
        _isModalVisible = false;
        return Task.CompletedTask;
    }

    class BrowserDimension
    {
        public int Width { get; set; }
        public int Height { get; set; }
    }
}