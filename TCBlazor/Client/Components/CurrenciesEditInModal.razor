@using TCalcCore.Engine
@inject TourcalcEngine engine

@if (!open){
    <u style="cursor: pointer;" @onclick=@(() => open = true)><i>@tour.Currency.Name</i></u>
} else {
    <TcModal Title=@($"Edit {tour.Name} Currencies")
       Visible="@open"
       OnCancel=@(() => open = false)
       Footer=@applyFooter
       Closable=@true
       Width="600">
        <div class="grid-table" style="grid-template-columns: repeat(2,auto);">
        <div class="row">
           <div class="grid-header grid-cell-span-all-cols">Tour <i>@tour.Name</i> Currencies</div>
        </div>
        <div class="row">
            <div class="grid-cell"><b>Current Currency</b></div>
            <div class="grid-cell">
                    <select class="tcn-input" @bind="CurrentCurrencyId">
                        @foreach (var c in Currencies)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
            </div>
        </div>
        <div class="row"><div class="grid-header grid-cell-span-all-cols"><hr/></div></div>
        <div class="row">
            <div class="grid-cell">Currencies in tour</div>
            <div class="grid-cell">
                <ol>
                    @foreach (var c in Currencies){
                       <li>
                           Name: <input size="3" type="text" @bind-value=@c.Name /> 
                           Worth: <input style="width: 7em" type="number" @bind-value=@c.CurrencyRate />
                           <Button Shape="@ButtonShape.Circle"
                                Icon="@IconType.Outline.Close" Size="ButtonSize.Small" Danger @onclick=@(() => Currencies.Remove(c))/>
                       </li>
                    }
                </ol>
            </div>
        </div>
        <div class="row"><div class="grid-header grid-cell-span-all-cols"><hr/></div></div>
        <div class="row">
            <div class="grid-cell">Add Currency</div>
            <div class="grid-cell"><ul>
                <li>
                   Name: <input size="3" type="text" @bind-value=@newCurrency.Name /> 
                   Worth: <input style="width: 7em" type="number" @bind-value=@newCurrency.CurrencyRate />
                   <Button Size="ButtonSize.Small" @onclick=@(() => AddNew())>Add</Button>
                </li>
            </ul></div>
        </div>
       </div>

    </TcModal>
}



@code {
    /// <summary>A select carries strings; the tour carries a Currency.</summary>
    private string CurrentCurrencyId
    {
        get => Currency?.Id ?? "";
        set
        {
            var picked = Currencies?.FirstOrDefault(c => c.Id == value);
            if (picked != null) Currency = picked;
        }
    }

    // AntDesign's default footer called OnOk; the buttons are explicit now
    private RenderFragment applyFooter => @<span>
        <button type="button" class="tcn-btn" @onclick=@(() => open = false)>Cancel</button>
        <button type="button" class="tcn-btn tcn-btn-primary" @onclick=@Apply>OK</button>
    </span>;

    [Parameter]
    public Tour tour { get; set; } = new();
    bool open = false;
    Currency Currency = new();
    List<Currency> Currencies = new List<Currency>();
    protected override void OnParametersSet()
    {
        Currencies.Clear();
        Currency = new Currency() { Name = tour.Currency.Name, CurrencyRate = tour.Currency.CurrencyRate };
        foreach (var c in tour.Currencies)
        {
            Currencies.Add(new Currency() { Name = c.Name, CurrencyRate = c.CurrencyRate });
        }
    }
    public void AddNew()
    {
        Currencies.Add(newCurrency);
        newCurrency = new() { Name = "", CurrencyRate = 100 };
    }
    public void Apply(){
        _ = engine.RequestEditTourProps(tour, ("SetTourCurrencies", Currencies), ("SetTourCurrency", Currency));
        //_ = engine.RequestTourLoad(tour.Id);
        open = false;
    }
    Currency newCurrency = new() { Name = "", CurrencyRate = 100 };
}
