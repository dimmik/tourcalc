@using TCalcCore.Engine
@inject TourcalcEngine engine
@inject UiModeService uiMode

@if (uiMode.IsNew)
{
    <button type="button" class="tcn-btn tcn-btn-sm" @onclick=@(() => open = true)>edit</button>
}
else
{
    <Button Size="ButtonSize.Small" @onclick=@(() => open = true)>edit</Button>
}
@if (open && uiMode.IsNew)
{
    <SpendingModalNew tour=@tour
                      TheSpending=@spending
                      Title=@($"Edit expense")
                      OnSave=@(EventCallback.Factory.Create<Spending>(this, SaveSpending))
                      OnClose=@(EventCallback.Factory.Create(this, () => open = false)) />
}
else if (open)
{
    <Modal Title=@($"Edit {spending.Description}")
       Visible="@open"
       Footer=@(footer(() => open = false))
       OnOk=@(() => open = false)
       OnCancel=@(() => open = false)
       DestroyOnClose=@true
       Closable=@true
       Width="600"
       >
       
        <TSpModifyComponent
            tour=@tour
            TheSpending=@spending
            OnSave=@SaveSpending
            OnFromChanged=@((g) => {})
            OnCancel=@(() => open = false)
            OnX=@(() => open = false)
            TitleText=@($"Edit {spending.Description}")
        />


    </Modal>
}

@code {
    [Parameter]
    public Spending spending { get; set; } = new();
    [Parameter]
    public Tour tour { get; set; } = new();

    private bool open = false;

    private void SaveSpending(Spending s)
    {
        _ = engine.RequestEditSpending(tour.Id, s);
        open = false;
    }


    private RenderFragment footer(Action onOk)
    {
        return __builder =>
        {
            <span/>
        };
    }
}
