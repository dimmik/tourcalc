@inject IJSRuntime JsRuntime
@inject NavigationManager NavManager
<div style="text-align: center; width: 100%;">
    <div
        style=@($"margin-left: auto; margin-right: auto;text-align:left; width: clamp(300px, 40vw, 500px); "+
                $"background-color: {(string.IsNullOrWhiteSpace(spending.Color) ? "#e6ffff" : spending.Color)};"+
                $" padding: 5px; border-radius: 5px; border: 1px solid black;")
    >
<div class="grid-table" style="grid-template-columns: 1fr 2fr;">
        <div class="grid-header grid-cell-span-all-cols">
                    <span style="cursor:pointer;" @onclick=@(() => spending.Color = "")>(clear)</span> 
                    <input type="color" @bind-value=@spending.Color/>
            @TitleText
            <Switch @bind-Value=@(spending.IsDryRun) CheckedChildren="DryRun" UnCheckedChildren="Real" Size="InputSize.Small"/>
            @if (spending.IsDryRun){
            <Switch @bind-Value=@(spending.IncludeDryRunInCalc) CheckedChildren="Include" UnCheckedChildren="Omit"  Size="InputSize.Small"/>
            }
        </div>
        <div class="grid-cell label">Description:</div>
        <div class="grid-cell">
            <Input @bind-Value=@(spending.Description)/>
        </div>
        <div class="grid-cell label">Amount:</div>
        <div class="grid-cell">
            <Input @bind-Value=@(spending.AmountInCents) Type="InputType.Number"/>
        </div>
         @if (tour.IsMultiCurrency())
         {
            <div class="grid-cell label">Currency:</div>
            <div class="grid-cell">
                <select class="tcn-input" @bind="CurrencyId">
                    @foreach (var c in tour.Currencies)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>
         }
        <div class="grid-cell label">Category:</div>
        <div class="grid-cell">
            <select class="tcn-input" @bind="spending.Type">
                <option value=""></option>
                @foreach (var c in SpendingCategories)
                {
                    <option value="@c">@c</option>
                }
            </select>
            @* AntDesign let a new category be typed inside the dropdown itself; a plain
               select has no room for markup, so the same field sits next to it *@
            <div class="tcn-row" style="margin-top:4px">
                <input class="tcn-input" style="flex:1 1 auto" placeholder="new category"
                       @bind-value="_cname" />
                <button type="button" class="tcn-btn tcn-btn-sm" @onclick="AddCatToList">+ Add</button>
            </div>
        </div>
        <div class="grid-cell label">From:</div>
        <div class="grid-cell">
            <select class="tcn-input" @onchange="@(e => PickFrom(e.Value?.ToString()))">
                <option value="">From...</option>
                @foreach (var p in TourPersons())
                {
                    <option value="@p.GUID" selected="@(spending.FromGuid == p.GUID)">@PersonLabel(p)</option>
                }
            </select>
        </div>
        <div class="grid-cell label">To All:</div>
        <div class="grid-cell">
            <Switch @bind-Value=@(spending.ToAll)></Switch>
        </div>
        <div class="grid-cell label">To:</div>
        <div class="grid-cell">
            @* the multiple-select showed removable tags; checkboxes say the same and
               need no widget of their own *@
            @foreach (var p in TourPersons())
            {
                <label class="tcn-switchline" style="display:block">
                    <input type="checkbox" disabled="@spending.ToAll"
                           checked="@spending.ToGuid.Contains(p.GUID)"
                           @onchange="@(e => ToggleTo(p.GUID, (bool)(e.Value ?? false)))" />
                    @PersonLabel(p)
                </label>
            }
        </div>
        <div class="grid-cell label">Date: </div>
        <div class="grid-cell">
            <input type="date" @bind-value=@spending.SpendingDate/>
        </div>
        <div class="grid-cell grid-cell-span-all-cols">
            <div style="display: table; width: 100%">
                    <div style="display: table-cell; align-content: flex-start; width: 65%; text-align: start;">
            <Button Type="@ButtonType.Primary" Loading=@ShowInProgress @onclick=@SaveSpending>
                @($"{(IsItANewSpending() ? "Submit" : "Submit")}")
            </Button>
            <Button Danger=@true @onclick=@OnCancel>
                Cancel
            </Button>
                </div>
                    <div style="display: table-cell; align-content: flex-end; width: 35%; text-align: end;">
                        <Button Type="@ButtonType.Primary" Danger=@true 
                            Shape="@ButtonShape.Circle"
                            Icon="@IconType.Outline.Close"
                            @onclick=@(OnX == null ? () => NavManager.NavigateTo($"/tour/{tour.Id}") : OnX)/>
                </div>
            </div>
        </div>
</div>
</div>
</div>


@code {
    [Parameter]
    public Spending TheSpending { get; set; } = new();
    public Spending spending = new();

    [Parameter]
    public Tour tour { get; set; } = new Tour();

    [Parameter]
    public Action<Spending> OnSave { get; set; } = (s) => { };

    [Parameter]
    public Action OnCancel { get; set; } = () => { };


    [Parameter]
    public Action<string> OnFromChanged { get; set; } = (s) => { };

    [Parameter]
    public string TitleText { get; set; } = "NEW";

    [Parameter]
    public Action? OnX { get; set; } = null;

    private bool IsItANewSpending()
    {
        return !tour.Spendings.Any(s => !s.Planned && s.GUID == spending.GUID);
    }

    private List<string> SpendingCategories = new List<string>();


    private string PersonLabel(Person p)
    {
        if (string.IsNullOrWhiteSpace(p.ParentId)) return p.Name;
        return $"> {p.Name}";
    }

    private IEnumerable<Person> TourPersons()
    {
        IEnumerable<Person> res = tour?.Persons ?? new();
        res = res.SortedByNameAndDependency();
        return res;
    }

    protected override void OnParametersSet()
    {
        var tourSpendingTypes = tour?.Spendings
            ?.Where(s => !s.Planned)
            ?.Where(s => !string.IsNullOrWhiteSpace(s.Type))
            ?.OrderByDescending(s => s.DateCreated)
            ?.Select(s => s.Type)?.Distinct()
            ?.ToArray();

        if (spending.GUID != TheSpending.GUID)
        {
            spending = TheSpending.SafeClone<Spending>();
            if (IsItANewSpending()){
                spending.Currency = tour.Currency;
                spending.SpendingDate = DateTime.Now;
            }
        }

        if (tourSpendingTypes is not null && tourSpendingTypes.Length > 0 && IsItANewSpending())
        {
            spending.Type = tourSpendingTypes[0];
        }

        _selectedValuesTo = spending.ToGuid;

        SpendingCategories = (
                tourSpendingTypes?.OrderBy(s => s) ?? Enumerable.Empty<string>()
            )
            .Concat(new[] { "Common" }) // add a common
            .Distinct()
            .ToList();
        
    }

    IEnumerable<string> _selectedValuesTo = new List<string>();

    /// <summary>A select carries strings, the spending carries a Currency.</summary>
    private string CurrencyId
    {
        get => spending.Currency?.Id ?? "";
        set
        {
            var picked = tour.Currencies.FirstOrDefault(c => c.Id == value);
            if (picked != null) spending.Currency = picked;
        }
    }

    /// <summary>AntDesign's two-way binding set this itself; now it is explicit.</summary>
    private void PickFrom(string guid)
    {
        spending.FromGuid = guid ?? "";
        OnFromSelectedChangedHandler(spending.FromGuid);
    }

    private void ToggleTo(string guid, bool on)
    {
        var chosen = new List<string>(spending.ToGuid ?? new List<string>());
        if (on) { if (!chosen.Contains(guid)) chosen.Add(guid); }
        else { chosen.Remove(guid); }
        OnToPersonsChangedHandler(chosen);
    }

    private void OnToPersonsChangedHandler(IEnumerable<string> values)
    {
        if (values != null){
            spending.ToGuid = values.ToList();
        }
    }

    public void OnFromSelectedChangedHandler(string v)
    {
        OnFromChanged(v);
    }
    bool ShowInProgress = false;
    private void SaveSpending()
    {
        List<string> err = new List<string>();
        if (spending.AmountInCents == 0)
        {
            err.Add("Amount should not be 0");
        }
        if (string.IsNullOrWhiteSpace(spending.Description))
        {
            err.Add("Please Specify Description");
        }
        if (!spending.ToAll && (spending.ToGuid ?? new List<string>()).Count == 0)
        {
            err.Add("Spending should have recepients or be to all");
        }
        if (string.IsNullOrWhiteSpace(spending.FromGuid))
        {
            err.Add("FROM is empty");
        }
        if (err.Count == 0)
        {
            ShowInProgress = true;
            if (IsItANewSpending()){ // store currencies. TODO probably should be implemented in another place.
                //spending.Currencies = tour?.Currencies?.ToArray() ?? new Currency[0];
            }
            OnSave(spending);
            ShowInProgress = false;
        } else
        {
            _ = JsRuntime.InvokeVoidAsync("alert", $"Errors: {string.Join("\n", err)}");
        }
    }


    private string _cname = "";
    private void AddCatToList(MouseEventArgs args)
    {
        var name = (_cname ?? "").Trim();
        if (string.IsNullOrWhiteSpace(name)) return;

        // a name that is already there is not an error - the point of typing it was to
        // use it, so fall through to selecting it either way
        if (!SpendingCategories.Contains(name))
        {
            SpendingCategories.Add(name);
        }
        // you typed a category to put this spending in it; leaving the previous one
        // selected meant the new one was added and then silently ignored
        spending.Type = name;
        _cname = string.Empty;
    }

}
