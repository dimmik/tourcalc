@namespace TCBlazor.Client.Components.NewUI

@implements IDisposable

@inject IJSRuntime JsRuntime
@inject NavigationManager NavManager

@* Copies the invite link instead of navigating to it - following it yourself,
   which is what the plain <a> did, is never what you want here. *@

<button type="button" class="@CssClass" title="@Url" @onclick=@Copy>
    @if (copied)
    {
        <span>✓ copied</span>
    }
    else
    {
        <span>@Text</span>
    }
</button>

@if (failed)
{
    @* the browser refused to copy - offer it in a dialog rather than dropping a
       white input into the middle of the coloured header *@
    <Modal Visible=@true
           Footer="null"
           Closable=@false
           DestroyOnClose=@true
           MaskClosable=@true
           OnCancel=@(e => failed = false)
           WrapClassName="tcn-sheet"
           BodyStyle="padding:0"
           Width="460">
        <div class="tcn-sheet-head">
            <div class="tcn-sheet-title">Copy the link</div>
            <button type="button" class="tcn-sheet-x" title="Close" @onclick=@(() => failed = false)>✕</button>
        </div>
        <div class="tcn-sheet-body">
            <div class="tcn-hint" style="margin-bottom:8px">
                Your browser would not let the page write to the clipboard. Here is the link — select and copy it.
            </div>
            <input class="tcn-input" type="text" readonly value="@Url" />
        </div>
        <div class="tcn-sheet-foot">
            <span style="flex:1 1 auto"></span>
            <button type="button" class="tcn-btn tcn-btn-primary" @onclick=@(() => failed = false)>Done</button>
        </div>
    </Modal>
}

@code {
    [Parameter]
    public Tour? Tour { get; set; }

    [Parameter]
    public string Text { get; set; } = "share link";

    [Parameter]
    public string CssClass { get; set; } = "tcn-hero-link";

    private bool copied = false;
    private bool failed = false;
    private CancellationTokenSource? resetCts;

    private string Url => $"{NavManager.BaseUri}goto/{Tour?.AccessCodeMD5}/{Tour?.Id}";

    private async Task Copy()
    {
        bool ok;
        try
        {
            ok = await JsRuntime.InvokeAsync<bool>("tcCopyText", Url);
        }
        catch
        {
            ok = false;
        }

        failed = !ok;
        copied = ok;
        StateHasChanged();

        if (!ok) return;

        // let the confirmation fade on its own
        resetCts?.Cancel();
        resetCts = new CancellationTokenSource();
        var token = resetCts.Token;
        try
        {
            await Task.Delay(1800, token);
            copied = false;
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
            // superseded by another click
        }
    }

    public void Dispose()
    {
        resetCts?.Cancel();
        resetCts?.Dispose();
    }
}
