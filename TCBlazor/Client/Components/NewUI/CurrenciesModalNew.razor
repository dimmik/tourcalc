@namespace TCBlazor.Client.Components.NewUI

@using TCalcCore.Engine

@inject TourcalcEngine engine
@inject IJSRuntime JsRuntime

@* Same two operations as the classic editor (SetTourCurrencies / SetTourCurrency).
   The list always ends with a blank row, so there is nothing to "add" and nothing to
   forget to add - the old separate Add button silently dropped whatever was typed
   into it if you pressed Save instead. *@

@* deliberately not just the currency name: next to "show amounts in" it read as the same
   control, while this one changes the tour for everybody *@
<button type="button" class="tcn-hero-chip" title="Edit the currencies of this tour" @onclick=@Open>
    ⚙ currencies
</button>

@if (open)
{
    <Modal Visible=@true
           Footer="null"
           Closable=@false
           DestroyOnClose=@true
           MaskClosable=@true
           OnCancel=@(e => open = false)
           WrapClassName="tcn-sheet"
           BodyStyle="padding:0"
           Width="480">

        <div class="tcn-sheet-head">
            <div class="tcn-sheet-title">Currencies of @tour.Name</div>
            <button type="button" class="tcn-sheet-x" title="Close" @onclick=@(() => open = false)><TcIcon Name="close" /></button>
        </div>

        <div class="tcn-sheet-body">
            @if (errors.Any())
            {
                <div class="tcn-errors">
                    @foreach (var e in errors)
                    {
                        <div>@e</div>
                    }
                </div>
            }

            <div class="tcn-field">
                <div class="tcn-label">Main currency</div>
                <div class="tcn-chips">
                    @foreach (var c in Filled())
                    {
                        <span class="tcn-chip tcn-filter-chip @(ReferenceEquals(current, c) ? "is-on" : "")"
                              @key=@($"cur_{c.Id}") @onclick=@(() => current = c)>@c.Name</span>
                    }
                </div>
                <div class="tcn-hint">
                    Totals and balances are calculated in this one. It is a property of the tour —
                    changing it affects everyone. To change only what <i>you</i> see, use
                    “show amounts in” in the header instead.
                </div>
            </div>

            <div class="tcn-field">
                <div class="tcn-label">Rates</div>
                <div class="tcn-hint" style="margin: 0 0 8px 0">
                    “Worth” is what one unit is worth on any scale you like — only the ratio matters.
                    If one euro is 118 dinars, put 100 next to the dinar and 11800 next to the euro.
                </div>

                @for (int i = 0; i < currencies.Count; i++)
                {
                    var idx = i;
                    var c = currencies[idx];
                    var blank = IsBlank(c);
                    <div class="tcn-currow" @key=@idx>
                        <input class="tcn-input tcn-cur-name" type="text"
                               placeholder=@(blank ? "add a currency…" : "")
                               value=@c.Name
                               @oninput=@(e => OnNameInput(idx, e)) />
                        <span class="tcn-cur-worth-label">worth</span>
                        <input class="tcn-input tcn-cur-rate" type="number" min="1"
                               value=@c.CurrencyRate
                               @onchange=@(e => OnRateInput(idx, e)) />
                        @if (blank)
                        {
                            <span class="tcn-currow-spacer"></span>
                        }
                        else
                        {
                            <button type="button" class="tcn-btn tcn-btn-sm tcn-btn-danger" title="Remove"
                                    @onclick=@(() => Remove(idx))><TcIcon Name="close" /></button>
                        }
                    </div>
                }

                <div class="tcn-hint">
                    Renaming keeps the amounts: expenses stay attached to the currency they were
                    entered in, whatever you call it now. Removing one does not — those expenses
                    would be read in the main currency.
                </div>
            </div>
        </div>

        <div class="tcn-sheet-foot">
            <span style="flex:1 1 auto"></span>
            <button type="button" class="tcn-btn" @onclick=@(() => open = false)>Cancel</button>
            <button type="button" class="tcn-btn tcn-btn-primary" @onclick=@Apply>Save</button>
        </div>
    </Modal>
}

@code {
    [Parameter]
    public Tour tour { get; set; } = new();

    private bool open = false;
    private Currency? current = null;
    private List<Currency> currencies = new();
    private List<string> errors = new();

    private static bool IsBlank(Currency c) => string.IsNullOrWhiteSpace(c.Name);

    private IEnumerable<Currency> Filled() => currencies.Where(c => !IsBlank(c));

    private void Open()
    {
        // Id is copied on purpose. It is what an expense is matched against, so keeping it
        // is what lets a currency be renamed without re-reading old expenses in another one.
        // (It used to survive only because IndexOf in a @key happened to materialise it.)
        currencies = tour.Currencies
            .Select(c => new Currency { Id = c.Id, Name = c.Name, CurrencyRate = c.CurrencyRate })
            .ToList();
        current = currencies.FirstOrDefault(c => c.Id == tour.Currency.Id) ?? currencies.FirstOrDefault();
        errors.Clear();
        EnsureTrailingBlank();
        open = true;
    }

    private void EnsureTrailingBlank()
    {
        // exactly one empty row at the end, always
        while (currencies.Count > 0 && IsBlank(currencies[currencies.Count - 1])
               && currencies.Count > 1 && IsBlank(currencies[currencies.Count - 2]))
        {
            currencies.RemoveAt(currencies.Count - 1);
        }
        if (currencies.Count == 0 || !IsBlank(currencies[currencies.Count - 1]))
        {
            currencies.Add(new Currency { Name = "", CurrencyRate = 100 });
        }
    }

    private void OnNameInput(int idx, ChangeEventArgs e)
    {
        if (idx >= currencies.Count) return;
        currencies[idx].Name = e.Value?.ToString() ?? "";
        EnsureTrailingBlank();
    }

    private void OnRateInput(int idx, ChangeEventArgs e)
    {
        if (idx >= currencies.Count) return;
        if (int.TryParse(e.Value?.ToString(), out var v))
        {
            currencies[idx].CurrencyRate = v;
        }
    }

    private async Task Remove(int idx)
    {
        if (idx >= currencies.Count) return;
        var c = currencies[idx];
        var ok = await JsRuntime.InvokeAsync<bool>("confirm",
            $"Remove {c.Name} from this tour? Expenses recorded in it will be read in the main currency.");
        if (!ok) return;
        var wasCurrent = ReferenceEquals(current, c);
        currencies.RemoveAt(idx);
        EnsureTrailingBlank();
        if (wasCurrent) current = Filled().FirstOrDefault();
    }

    private void Apply()
    {
        var kept = Filled().ToList();
        errors = Validate(kept);
        if (errors.Any())
        {
            StateHasChanged();
            return;
        }
        var chosen = kept.FirstOrDefault(c => ReferenceEquals(c, current)) ?? kept.FirstOrDefault() ?? Currency.Default;
        _ = engine.RequestEditTourProps(tour, ("SetTourCurrencies", kept), ("SetTourCurrency", chosen));
        open = false;
    }

    private static List<string> Validate(List<Currency> kept)
    {
        var err = new List<string>();
        if (!kept.Any())
        {
            err.Add("A tour needs at least one currency");
            return err;
        }
        // the rate ends up as a divisor when amounts are converted
        foreach (var c in kept.Where(c => c.CurrencyRate <= 0))
        {
            err.Add($"“{c.Name}” needs a worth above zero");
        }
        foreach (var g in kept.GroupBy(c => c.Name.Trim()).Where(g => g.Count() > 1))
        {
            err.Add($"“{g.Key}” is listed more than once — names have to be unique");
        }
        return err;
    }
}
