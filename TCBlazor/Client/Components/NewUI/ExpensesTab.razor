@namespace TCBlazor.Client.Components.NewUI

@using TCalc.Logic
@using TCalcCore.Engine

@inject TourcalcEngine engine
@inject IJSRuntime JsRuntime

@{
    var all = RealSpendings().ToList();
    var shown = Filter(all).ToList();
    var curName = Tour.CurrencyNameEmptyIfSingleCurrency();
    var categories = all.Select(s => s.Type).Where(t => !string.IsNullOrWhiteSpace(t)).Distinct().OrderBy(t => t).ToList();
    // one pass instead of recomputing the same sums for the headline, the value and the details
    var shownCounted = shown.Where(CountsAsSpending).Sum(s => s.AmountInCurrentCurrency(Tour));
    var shownOther = shown.Where(s => !CountsAsSpending(s)).Sum(s => s.AmountInCurrentCurrency(Tour));
    var planned = PlannedSpendings().ToList();
}

<div class="tcn-toolbar">
    <div class="tcn-search">
        <span class="tcn-search-icon">🔎</span>
        <input type="text" placeholder="Search by description, payer or category" value="@search"
               @oninput=@(e => search = e.Value?.ToString() ?? "") />
        @if (!string.IsNullOrEmpty(search))
        {
            <button type="button" class="tcn-search-clear" title="Clear" aria-label="Clear the search" @onclick=@(() => search = "")><TcIcon Name="close" /></button>
        }
    </div>
    <button type="button" class="tcn-btn tcn-btn-sm @(sortBy == Sort.Date ? "tcn-btn-primary" : "")" @onclick=@(() => ToggleSort(Sort.Date))>
        Date @(sortBy == Sort.Date ? (desc ? "↓" : "↑") : "")
    </button>
    <button type="button" class="tcn-btn tcn-btn-sm @(sortBy == Sort.Amount ? "tcn-btn-primary" : "")" @onclick=@(() => ToggleSort(Sort.Amount))>
        Amount @(sortBy == Sort.Amount ? (desc ? "↓" : "↑") : "")
    </button>
</div>

@if (categories.Any())
{
    <div class="tcn-chips" style="margin-bottom: 10px;">
        @foreach (var c in categories)
        {
            <span class="tcn-chip tcn-filter-chip @(activeCategories.Contains(c) ? "is-on" : "")"
                  @key=@($"cat_{c}")
                  @onclick=@(() => ToggleCategory(c))>
                @c
            </span>
        }
        @if (activeCategories.Any())
        {
            <span class="tcn-chip tcn-filter-chip" @onclick=@(() => activeCategories.Clear())>clear ×</span>
        }
    </div>
}

@if (shown.Any())
{
    <div class="tcn-summary">
        <span><b>@shown.Count</b> expenses</span>
        <span>
            spent
            <Explain Enabled=@Explainable Title="Spending in the shown expenses"
                     Headline=@($"{NewUi.Money(shownCounted)} {curName}")
                     Details=@ShownTotalDetails(shown)>
                <b>@NewUi.Money(shownCounted)</b>
            </Explain>
            @curName
        </span>
        @if (shownOther != 0)
        {
            @* this is exactly why the header total and this one used to disagree *@
            <span class="tcn-hint">
                +
                @* always tappable, setting or no setting: "uncounted" begs the question by itself *@
                <Explain Enabled="true" Title="Not counted as spending"
                         Headline=@($"{NewUi.Money(shownOther)} {curName}")
                         Details=@UncountedDetails(shown)>
                    @NewUi.Money(shownOther) @UncountedLabel(shown)
                </Explain>
            </span>
        }
        <span>from <b>@shown.Min(s => s.SpendingDate).ToString("dd.MM.yyyy")</b> to <b>@shown.Max(s => s.SpendingDate).ToString("dd.MM.yyyy")</b></span>
        @if (shown.Count != all.Count)
        {
            <span style="color: var(--tcn-primary)">filtered out of @all.Count</span>
        }
    </div>
}

@if (!all.Any())
{
    <div class="tcn-empty">
        <span class="tcn-empty-icon">🧾</span>
        <div class="tcn-empty-title">No expenses yet</div>
        <div>Tap <b>Spend</b> to record who paid for what.</div>
    </div>
}
else if (!shown.Any())
{
    <div class="tcn-empty">
        <span class="tcn-empty-icon">🔍</span>
        <div class="tcn-empty-title">Nothing matches the filter</div>
        <div>Try a different search text or clear the category filter.</div>
    </div>
}
else if (sortBy == Sort.Date)
{
    var byDay = shown.GroupBy(s => s.SpendingDate.Date);
    var days = desc ? byDay.OrderByDescending(g => g.Key) : byDay.OrderBy(g => g.Key);
    foreach (var day in days)
    {
        <div class="tcn-daygroup" @key=@($"day_{day.Key.Ticks}")>
            <div class="tcn-dayhead">
                <span>@NewUi.DayLabel(day.Key)</span>
                @{
                    var dayRows = day.ToList();
                    var dayCounted = dayRows.Where(CountsAsSpending).Sum(x => x.AmountInCurrentCurrency(Tour));
                    var dayOther = dayRows.Where(x => !CountsAsSpending(x)).Sum(x => x.AmountInCurrentCurrency(Tour));
                }
                <span class="tcn-daysum">
                    <Explain Enabled=@Explainable Title=@($"{NewUi.DayLabel(day.Key)}")
                             Headline=@($"{NewUi.Money(dayCounted)} {curName}")
                             Details=@DayDetails(dayRows)>
                        @NewUi.Money(dayCounted)
                    </Explain>
                    @curName
                    @if (dayOther != 0)
                    {
                        <span class="tcn-hint">
                            &nbsp;+
                            <Explain Enabled="true" Title=@($"Not counted on {NewUi.DayLabel(day.Key)}")
                                     Headline=@($"{NewUi.Money(dayOther)} {curName}")
                                     Details=@UncountedDetails(dayRows)>
                                @NewUi.Money(dayOther) @UncountedLabel(dayRows)
                            </Explain>
                        </span>
                    }
                </span>
            </div>
            @foreach (var s in day)
            {
                @SpendingRow(s)
            }
        </div>
    }
}
else
{
    <div>
        @foreach (var s in shown)
        {
            @SpendingRow(s)
        }
    </div>
}

@if (planned.Count > 0)
{
    <div class="tcn-section" style="margin-top: 14px;">
        <button type="button" class="tcn-btn tcn-btn-ghost tcn-btn-block" @onclick=@(() => showPlanned = !showPlanned)>
            <TcIcon Name=@(showPlanned ? "chevron-down" : "chevron-right") />
            @(showPlanned ? "Hide the suggested settle-up payments" : $"Show the {planned.Count} suggested settle-up payments")
        </button>
        @if (showPlanned)
        {
            <div style="margin-top: 8px;">
                @foreach (var s in planned)
                {
                    @SpendingRow(s)
                }
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public Tour Tour { get; set; } = new();

    /// <summary>The un-converted tour - the edit form has to work with the original currencies.</summary>
    [Parameter]
    public Tour RawTour { get; set; } = new();

    [Parameter]
    public UISettings Settings { get; set; } = new();

    private bool showPlanned = false;
    private string search = "";
    private HashSet<string> activeCategories = new();
    private enum Sort { Date, Amount }
    private Sort sortBy = Sort.Date;
    private bool desc = true;

    /// <summary>What the tour counts as actual spending - paybacks and uncounted drafts are not.</summary>
    private static bool CountsAsSpending(Spending s)
        => !s.Planned && !string.IsNullOrWhiteSpace(s.Type) && (!s.IsDryRun || s.IncludeDryRunInCalc);

    private long MinMeaningful => Tour.GetAmountInCurrentCurrencyFromMinValued(Settings.MinimumMeaningfulDebt);

    private IEnumerable<Spending> RealSpendings()
        => (Tour?.Spendings ?? new List<Spending>()).Where(s => !s.Planned);

    private IEnumerable<Spending> PlannedSpendings()
        => (Tour?.Spendings ?? new List<Spending>())
            .Where(s => s.Planned && Math.Abs(s.AmountInCurrentCurrency(Tour)) > MinMeaningful)
            .OrderBy(s => s.Description.StartsWith("Family") ? 0 : 1)
            .ThenByDescending(s => s.AmountInCurrentCurrency(Tour));

    private IEnumerable<Spending> Filter(IEnumerable<Spending> src)
    {
        var res = src;
        if (activeCategories.Any())
        {
            res = res.Where(s => activeCategories.Contains(s.Type ?? ""));
        }
        var q = search.Trim();
        if (q.Length > 0)
        {
            res = res.Where(s =>
                (s.Description ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)
                || (s.Type ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)
                || NewUi.PersonName(Tour, s.FromGuid).Contains(q, StringComparison.OrdinalIgnoreCase));
        }
        res = sortBy == Sort.Amount
            ? (desc ? res.OrderByDescending(s => s.AmountInCurrentCurrency(Tour)) : res.OrderBy(s => s.AmountInCurrentCurrency(Tour)))
            : (desc ? res.OrderByDescending(s => s.SpendingDate) : res.OrderBy(s => s.SpendingDate));
        return res;
    }

    private void ToggleSort(Sort s)
    {
        if (sortBy == s) { desc = !desc; }
        else { sortBy = s; desc = true; }
    }

    private void ToggleCategory(string c)
    {
        if (!activeCategories.Remove(c)) activeCategories.Add(c);
    }

    private static string RowClass(Spending s)
    {
        if (s.Planned) return s.Description.StartsWith("Family ") ? "tcn-sp-family" : "tcn-sp-planned";
        if (s.IsDryRun) return "tcn-sp-dry";
        if (s.Description.StartsWith("X ")) return "tcn-sp-payback";
        if (s.Description.StartsWith("Family ")) return "tcn-sp-family";
        return "";
    }

    private RenderFragment SpendingRow(Spending s) => __builder =>
    {
        var from = Tour.Persons.FirstOrDefault(p => p.GUID == s.FromGuid);
        var curName = Tour.CurrencyNameEmptyIfSingleCurrency();
        var amount = s.AmountInCurrentCurrency(Tour);
        // rows the calculator generated for itself are not named by anyone - show the transfer
        var svc = NewUi.AsServiceTransfer(s.Description);

        <div class="tcn-sp @RowClass(s) @(NewUi.IsMarked(s.Color) ? "tcn-sp-marked" : "")" style="@NewUi.MarkStyle(s.Color)" @key=@($"sp_{s.GUID}")>
            <span class="tcn-avatar tcn-avatar-sm" style="background:@NewUi.AvatarColor(from?.Name)" title="@(from?.Name)">
                @NewUi.Initials(from?.Name, Tour)
            </span>
            <div class="tcn-sp-body">
                <div class="tcn-sp-title">
                    @if (svc is {} t)
                    {
                        <span class="tcn-sp-transfer">
                            @t.From <span class="tcn-settle-arrow"><TcIcon Name="arrow-right" /></span> @t.To
                        </span>
                    }
                    else
                    {
                        @s.Description
                    }
                </div>
                <div class="tcn-sp-meta">
                    <span>@(from?.Name ?? "n/a")</span>
                    <span>·</span>
                    <span>@s.SpendingDate.ToString("dd.MM.yyyy HH:mm")</span>
                    @if (svc is {} k)
                    {
                        <span class="tcn-chip">@(k.Kind == "Family" ? "inside family" : "payback")</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(s.Type))
                    {
                        <span class="tcn-chip tcn-chip-primary">@s.Type</span>
                    }
                    @if (s.IsDryRun)
                    {
                        <span class="tcn-chip tcn-chip-amber">draft@(s.IncludeDryRunInCalc ? " · counted" : " · not counted")</span>
                    }
                    @if (s.Planned)
                    {
                        <span class="tcn-chip tcn-chip-amber">suggested</span>
                    }
                </div>
                <div class="tcn-sp-to">
                    @if (s.ToAll)
                    {
                        <span>for <b>everyone</b></span>
                    }
                    else
                    {
                        <span>
                            for <b>@string.Join(", ", s.ToGuid.Select(g => NewUi.PersonName(Tour, g)).OrderBy(n => n))</b>
                            @if (!s.IsPartialWeighted && s.ToGuid.Count > 1)
                            {
                                <span class="tcn-chip" style="margin-left:6px">split equally</span>
                            }
                        </span>
                    }
                </div>
            </div>
            <div class="tcn-sp-right">
                <div class="tcn-sp-amount">
                    <Explain Enabled=@Explainable Title=@s.Description Headline=@($"{NewUi.Money(amount)} {curName}")
                             Details=@SpendingDetails(s)>
                        @NewUi.Money(amount)
                    </Explain>
                    @if (!string.IsNullOrEmpty(curName))
                    {
                        <small>&nbsp;@curName</small>
                    }
                </div>
                @if (Tour.IsMultiCurrency() && s.Currency != Tour.Currency)
                {
                    <div class="tcn-sp-orig">@NewUi.Money(s.AmountInCents) @s.Currency.Name</div>
                }
                <div class="tcn-sp-actions">
                    @if (s.Planned)
                    {
                        <button type="button" class="tcn-btn tcn-btn-sm tcn-btn-settle"
                                title="Record that this money has actually changed hands"
                                @onclick=@(() => MarkPaid(s))>Mark paid</button>
                    }
                    else
                    {
                        @if (s.IsDryRun)
                        {
                            <button type="button" class="tcn-btn tcn-btn-sm" title="Turn this draft into a real expense"
                                    @onclick=@(() => MakeReal(s))>
                                make real
                            </button>
                        }
                        <SpendingEditInModal spending=@s tour=@RawTour @key=@($"sp_ed_{s.GUID}") />
                        <button type="button" class="tcn-btn tcn-btn-sm tcn-btn-danger" title="Delete" aria-label="Delete" @onclick=@(() => Delete(s))><TcIcon Name="close" /></button>
                    }
                </div>
            </div>
        </div>
    };

    private bool Explainable => Settings.Explain_Numbers;

    private RenderFragment ShownTotalDetails(List<Spending> shown) => __builder =>
    {
        var cur = Tour.CurrencyNameEmptyIfSingleCurrency();
        var byCat = shown.Where(CountsAsSpending).GroupBy(x => x.Type)
            .Select(g => (Cat: g.Key, Sum: g.Sum(x => x.AmountInCurrentCurrency(Tour)), N: g.Count()))
            .OrderByDescending(x => x.Sum).ToList();
        <div class="tcn-facts">
            @foreach (var c in byCat)
            {
                <div>@c.Cat <span class="tcn-hint">@c.N entr@(c.N == 1 ? "y" : "ies")</span></div>
                <div>@NewUi.Money(c.Sum)</div>
            }
        </div>
        <div class="tcn-explain-note">
            Only entries that count as spending are added up here — a payback or an uncounted draft
            moves money without spending it. Filters apply, so this is not necessarily the tour total.
        </div>
    };

    /// <summary>A draft that was never switched into the calculation.</summary>
    private static bool IsUncountedDraft(Spending s) => s.IsDryRun && !s.IncludeDryRunInCalc;

    /// <summary>No category: what "Mark paid" writes down - people squaring up between themselves.</summary>
    private static bool IsSettlingUp(Spending s) => !IsUncountedDraft(s) && string.IsNullOrWhiteSpace(s.Type);

    /// <summary>Name the reason when there is only one - most of the time no tap is needed.</summary>
    private static string UncountedLabel(IEnumerable<Spending> rows)
    {
        var un = rows.Where(s => !CountsAsSpending(s)).ToList();
        var drafts = un.Count(IsUncountedDraft);
        var transfers = un.Count(IsSettlingUp);
        if (drafts > 0 && transfers > 0) return "uncounted";
        if (drafts > 0) return drafts == 1 ? "draft" : "drafts";
        return "settling up";
    }

    private RenderFragment UncountedDetails(IEnumerable<Spending> rows) => __builder =>
    {
        var cur = Tour.CurrencyNameEmptyIfSingleCurrency();
        var un = rows.Where(s => !CountsAsSpending(s)).ToList();
        var transfers = un.Where(IsSettlingUp).ToList();
        var drafts = un.Where(IsUncountedDraft).ToList();

        if (transfers.Any())
        {
            <div class="tcn-label">Settling up · @NewUi.Money(transfers.Sum(x => x.AmountInCurrentCurrency(Tour))) @cur</div>
            <div class="tcn-facts">
                @foreach (var x in transfers.OrderByDescending(x => x.AmountInCurrentCurrency(Tour)))
                {
                    <div>@x.Description <span class="tcn-hint">@NewUi.PersonName(Tour, x.FromGuid)</span></div>
                    <div>@NewUi.Money(x.AmountInCurrentCurrency(Tour))</div>
                }
            </div>
            <div class="tcn-explain-note">
                Money handed from one person to another to clear a debt. It was already counted when
                the original expense was recorded — counting it again would double it.
            </div>
        }

        if (drafts.Any())
        {
            <div class="tcn-label" style="margin-top:14px">Drafts · @NewUi.Money(drafts.Sum(x => x.AmountInCurrentCurrency(Tour))) @cur</div>
            <div class="tcn-facts">
                @foreach (var x in drafts.OrderByDescending(x => x.AmountInCurrentCurrency(Tour)))
                {
                    <div>@x.Description <span class="tcn-hint">@NewUi.PersonName(Tour, x.FromGuid)</span></div>
                    <div>@NewUi.Money(x.AmountInCurrentCurrency(Tour))</div>
                }
            </div>
            <div class="tcn-explain-note">
                Written down as a maybe, not as something that happened. Open the entry and turn on
                “Still count it in the balance” to include it.
            </div>
        }
    };

    private RenderFragment DayDetails(List<Spending> day) => __builder =>
    {
        <div class="tcn-facts">
            @foreach (var x in day.OrderByDescending(x => x.AmountInCurrentCurrency(Tour)))
            {
                <div>@x.Description <span class="tcn-hint">@NewUi.PersonName(Tour, x.FromGuid)</span></div>
                <div>@NewUi.Money(x.AmountInCurrentCurrency(Tour))</div>
            }
        </div>
    };

    private RenderFragment SpendingDetails(Spending sp) => __builder =>
    {
        var cur = Tour.CurrencyNameEmptyIfSingleCurrency();
        var amount = sp.AmountInCurrentCurrency(Tour);
        var receivers = sp.ToAll
            ? Tour.Persons.ToList()
            : Tour.Persons.Where(p => sp.ToGuid.Contains(p.GUID)).ToList();
        var weight = receivers.Sum(p => p.Weight);
        <div class="tcn-facts">
            <div>Paid by</div>
            <div>@NewUi.PersonName(Tour, sp.FromGuid)</div>
            <div>When</div>
            <div>@sp.SpendingDate.ToString("dd.MM.yyyy HH:mm")</div>
            @if (!string.IsNullOrWhiteSpace(sp.Type))
            {
                <div>Category</div>
                <div>@sp.Type</div>
            }
            @if (Tour.IsMultiCurrency() && sp.Currency != Tour.Currency)
            {
                <div>Entered as</div>
                <div>@NewUi.Money(sp.AmountInCents) @sp.Currency.Name</div>
            }
        </div>

        <div class="tcn-label" style="margin-top:14px">Split between @receivers.Count</div>
        <div class="tcn-facts">
            @foreach (var p in receivers.OrderByDescending(p => p.Weight).ThenBy(p => p.Name))
            {
                var share = weight == 0 ? 0 : amount * p.Weight / weight;
                <div>@p.Name <span class="tcn-hint">weight @p.Weight</span></div>
                <div>@NewUi.Money(share)</div>
            }
        </div>
        <div class="tcn-explain-note">
            @if (sp.ToAll)
            {
                <span>Shared by everyone in the tour, split by weight.</span>
            }
            else if (receivers.Count == 1)
            {
                <span>Charged to one person only.</span>
            }
            else
            {
                <span>Charged to @receivers.Count people, split by weight (total weight @weight).</span>
            }
            @if (sp.IsDryRun)
            {
                <span> This is a draft@(sp.IncludeDryRunInCalc ? " and it is counted in the balance." : " and it is not counted in the balance.")</span>
            }
        </div>
    };

    private async Task Delete(Spending s)
    {
        bool ok = await JsRuntime.InvokeAsync<bool>("confirm", $"Delete spending '{s.Description}'?");
        if (ok)
        {
            _ = engine.RequestDeleteSpending(Tour?.Id, s);
        }
    }

    private Task MakeReal(Spending s)
    {
        s.IsDryRun = false;
        _ = engine.RequestEditSpending(Tour?.Id, s);
        return Task.CompletedTask;
    }

    private async Task MarkPaid(Spending s)
    {
        var from = NewUi.PersonName(Tour, s.FromGuid);
        var to = NewUi.PersonName(Tour, s.ToGuid.FirstOrDefault());
        bool ok = await JsRuntime.InvokeAsync<bool>("confirm",
            $"Record that {from} paid {NewUi.Money(s.AmountInCurrentCurrency(Tour))} to {to}?");
        if (!ok) return;
        var ss = s.SafeClone<Spending>();
        ss.Type = "";
        ss.Color = ss.Description.StartsWith("X") ? "lightgreen" : "lightgray";
        _ = engine.RequestAddSpending(Tour?.Id, ss);
    }
}
