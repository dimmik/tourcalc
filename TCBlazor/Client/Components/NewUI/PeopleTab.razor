@namespace TCBlazor.Client.Components.NewUI

@using TCalc.Logic
@using TCalcCore.Engine

@inject TourcalcEngine engine
@inject IJSRuntime JsRuntime

<div class="tcn-toolbar">
    <button type="button" class="tcn-btn tcn-btn-primary" @onclick=@(() => ShowEdit(new Person { GUID = "New" }))>
        + Add person
    </button>
    @if (Tour.Persons.Count > SearchFrom)
    {
        <div class="tcn-search">
            <span class="tcn-search-icon">🔎</span>
            <input type="text" placeholder="Find a person" value="@search"
                   @oninput=@(e => search = e.Value?.ToString() ?? "") />
            @if (!string.IsNullOrEmpty(search))
            {
                <button type="button" class="tcn-search-clear" title="Clear" aria-label="Clear the search"
                        @onclick=@(() => search = "")><TcIcon Name="close" /></button>
            }
        </div>
    }
    @if (Tour.Persons.Count > 1)
    {
        <button type="button" class="tcn-btn tcn-btn-sm @(Compact ? "tcn-btn-primary" : "")"
                title="One line per person - tap a line to open their numbers"
                @onclick=@ToggleCompact>Compact</button>
    }
    @if (Tour.Persons.Any())
    {
        <span class="tcn-chip">@CountLabel</span>
        <span class="tcn-chip">
            total weight
            <Explain Enabled=@Explainable Title="Total weight"
                     Headline=@($"{Tour.Persons.Sum(p => p.Weight)}")
                     Details=@WeightDetails>
                @Tour.Persons.Sum(p => p.Weight)
            </Explain>
        </span>
    }
</div>

@if (Tour.Persons.Any())
{
    <div class="tcn-hint" style="margin: -4px 2px 10px 2px">
        @if (Compact)
        {
            <span><b>Tap a name</b> to open what they paid, what their share cost, and the difference between the two.</span>
        }
        else
        {
            <span>
                <b>Paid</b> — what they put in · <b>Charged</b> — what their part of the spending cost ·
                @* the three cells are PersonBreakdown buttons and open their dialog whatever the
                   "tap any number" setting says - the invitation is true in both modes *@
                <b>Balance</b> — the difference. Tap any of the three for the itemised list.
            </span>
        }
    </div>
}

@if (!Tour.Persons.Any())
{
    <div class="tcn-empty">
        <span class="tcn-empty-icon">👥</span>
        <div class="tcn-empty-title">No participants yet</div>
        <div>Add everyone who takes part in the tour — then you can start recording expenses.</div>
    </div>
}
else if (!Shown().Any())
{
    <div class="tcn-empty">
        <div class="tcn-empty-title">Nobody here is called “@search”</div>
        <div>Try a shorter piece of the name.</div>
    </div>
}
else
{
    <div class="tcn-list tcn-people-list @(Compact ? "is-compact" : "")">
        @foreach (var person in Shown())
        {
            var isChild = !string.IsNullOrWhiteSpace(person.ParentId);
            var debt = Debt(person);
            // what actually changes hands: for someone who pays for others it also
            // carries their people, and that is a different number from their own debt
            var family = Settle(person);
            // someone who is paid for never hands anything over themselves - showing them as
            // "settled" while they clearly owe something was confusing, so they show their own debt
            var shown = isChild ? debt : family;
            var splitFamily = !isChild && Math.Abs(family - debt) > _minMeaningful;
            // in the dense list a person opens on demand; in the roomy one everything is open
            var isOpen = !Compact || expanded.Contains(person.GUID);
            <div class="tcn-person @(isChild ? "is-child" : "") @(Compact ? "is-compact" : "")" @key=@($"pers_{person.GUID}")>
                @if (Compact)
                {
                    <button type="button" class="tcn-person-row" aria-expanded=@(isOpen ? "true" : "false")
                            @onclick=@(() => Toggle(person.GUID))>
                        <span class="tcn-avatar tcn-avatar-sm" style="background:@NewUi.AvatarColor(person.Name)">@NewUi.Initials(person.Name, Tour)</span>
                        <span class="tcn-person-id">
                            <span class="tcn-person-name">@person.Name</span>
                            @if (isChild)
                            {
                                <span class="tcn-person-meta">paid by @NewUi.PersonName(Tour, person.ParentId)</span>
                            }
                        </span>
                        @* plain text rather than an Explain: a button inside a button is not
                           markup a browser accepts, and the itemised list is one tap away *@
                        <span class="tcn-chip @(isChild || shown == 0 ? "" : shown > 0 ? "tcn-chip-red" : "tcn-chip-green")"
                              title=@(isChild ? $"Settled through {NewUi.PersonName(Tour, person.ParentId)}" : "")>
                            @(shown > 0 ? $"owes {NewUi.Money(shown)}" : shown < 0 ? $"gets {NewUi.Money(-shown)}" : "settled")
                        </span>
                        <span class="tcn-person-caret"><TcIcon Name=@(isOpen ? "chevron-down" : "chevron-right") /></span>
                    </button>
                }
                else
                {
                    <div class="tcn-person-head">
                        <span class="tcn-avatar" style="background:@NewUi.AvatarColor(person.Name)">@NewUi.Initials(person.Name, Tour)</span>
                        <div class="tcn-person-id">
                            <div class="tcn-person-name">@person.Name</div>
                            <div class="tcn-person-meta">
                                <span>
                                    weight
                                    <Explain Enabled=@Explainable Title=@($"{person.Name}: weight {person.Weight}")
                                             Details=@PersonWeightDetails(person)>
                                        @person.Weight
                                    </Explain>
                                </span>
                                @if (isChild)
                                {
                                    <span>paid by <b>@NewUi.PersonName(Tour, person.ParentId)</b></span>
                                }
                            </div>
                        </div>
                        <div class="tcn-person-owe">
                            <Explain Enabled=@Explainable Title=@($"{person.Name}: where this comes from")
                                     Headline=@(shown > 0 ? $"owes {NewUi.Money(shown)}" : shown < 0 ? $"gets {NewUi.Money(-shown)}" : "settled")
                                     Details=@PersonDebtDetails(person, debt, family)>
                                @if (shown > 0)
                                {
                                    <span class="tcn-chip @(isChild ? "" : "tcn-chip-red")"
                                          title=@(isChild ? $"Settled through {NewUi.PersonName(Tour, person.ParentId)}" : "")>
                                        owes @NewUi.Money(shown)
                                    </span>
                                }
                                else if (shown < 0)
                                {
                                    <span class="tcn-chip @(isChild ? "" : "tcn-chip-green")"
                                          title=@(isChild ? $"Settled through {NewUi.PersonName(Tour, person.ParentId)}" : "")>
                                        gets @NewUi.Money(-shown)
                                    </span>
                                }
                                else
                                {
                                    <span class="tcn-chip">settled</span>
                                }
                            </Explain>
                            @if (splitFamily)
                            {
                                <span class="tcn-person-own" title="Their own debt, before the people they pay for">
                                    @(debt > 0 ? $"own: owes {NewUi.Money(debt)}" : debt < 0 ? $"own: gets {NewUi.Money(-debt)}" : "own: settled")
                                </span>
                            }
                        </div>
                    </div>
                }

                @if (isOpen)
                {
                    <div class="tcn-person-stats">
                        <PersonBreakdown Kind="PersonBreakdown.BreakdownKind.Paid"
                                         tour=@Tour person=@person debt="debt" minMeaningfulAmount=@MinMeaningful
                                         @key=@($"paid_{person.GUID}") />
                        <PersonBreakdown Kind="PersonBreakdown.BreakdownKind.Share"
                                         tour=@Tour person=@person debt="debt" minMeaningfulAmount=@MinMeaningful
                                         @key=@($"share_{person.GUID}") />
                        <PersonBreakdown Kind="PersonBreakdown.BreakdownKind.Balance"
                                         tour=@Tour person=@person debt="debt" WillPay="family" IsCovered="isChild" minMeaningfulAmount=@MinMeaningful
                                         @key=@($"bal_{person.GUID}") />
                    </div>

                    <div class="tcn-person-actions">
                        <button type="button" class="tcn-btn tcn-btn-sm tcn-btn-primary" @onclick=@(() => SpendFor(person))>💸 Spend</button>
                        <button type="button" class="tcn-btn tcn-btn-sm" @onclick=@(() => ShowEdit(person))>Edit</button>
                        <button type="button" class="tcn-btn tcn-btn-sm tcn-btn-danger" @onclick=@(() => DeletePerson(person))>Delete</button>
                    </div>
                }
            </div>
        }
    </div>
}

<PersonModalNew Person="@_personToEdit"
                Tour="@Tour"
                Visible="@_isModalVisible"
                OnOk="HandleModalOk"
                OnCancel="HandleModalCancel" />

@code {
    [Parameter]
    public Tour Tour { get; set; } = new();

    [Parameter]
    public UISettings Settings { get; set; } = new();

    [Parameter]
    public SpendingAddInModal AddModal { get; set; } = new();

    private bool _isModalVisible = false;
    private Person _personToEdit = new();

    /// <summary>Under this many people the list fits on a screen anyway and a search box is clutter.</summary>
    private const int SearchFrom = 8;

    /// <summary>
    /// From here on the roomy cards stop fitting on a phone (they are ~163px each), so a
    /// tour this size opens dense unless the reader has said otherwise.
    /// </summary>
    private const int CompactFrom = 7;

    private string search = "";
    private bool? compactChosen = null;
    private readonly HashSet<string> expanded = new();

    private bool Compact => compactChosen ?? Tour.Persons.Count >= CompactFrom;

    protected override async Task OnInitializedAsync()
    {
        compactChosen = await engine.GetPeopleCompact();
    }

    private async Task ToggleCompact()
    {
        var next = !Compact;
        compactChosen = next;
        expanded.Clear();
        await engine.SetPeopleCompact(next);
    }

    private void Toggle(string guid)
    {
        if (!expanded.Remove(guid)) expanded.Add(guid);
    }

    /// <summary>The people to draw: everyone, or whoever the search box leaves.</summary>
    private IEnumerable<Person> Shown()
    {
        var all = Tour.Persons.SortedByNameAndDependency();
        var q = search.Trim();
        if (q.Length == 0) return all;
        return all.Where(p =>
            (p.Name ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)
            // and by the name of whoever pays for them: you look for the family, not for
            // the child you had forgotten was part of it
            || (!string.IsNullOrWhiteSpace(p.ParentId)
                && NewUi.PersonName(Tour, p.ParentId).Contains(q, StringComparison.OrdinalIgnoreCase)));
    }

    private string CountLabel
    {
        get
        {
            var total = Tour.Persons.Count;
            if (string.IsNullOrWhiteSpace(search)) return $"{total} people";
            return $"{Shown().Count()} of {total} people";
        }
    }

    private int _minMeaningful = 0;
    private int MinMeaningful => _minMeaningful;

    protected override void OnParametersSet()
    {
        // computed once per render instead of twice per person
        _minMeaningful = Tour.GetAmountInCurrentCurrencyFromMinValued(Settings.MinimumMeaningfulDebt);
    }

    /// <summary>What this person hands over at settle-up, people they pay for included.</summary>
    private long Settle(Person p)
    {
        var v = Tour.AmountAPersonWillPay(p);
        return Math.Abs(v) > _minMeaningful ? v : 0;
    }

    private long Debt(Person p)
    {
        // hide amounts that are only rounding noise
        var d = p.Debt();
        return Math.Abs(d) > _minMeaningful ? d : 0;
    }

    private bool Explainable => Settings.Explain_Numbers;

    private RenderFragment WeightDetails => __builder =>
    {
        var total = Tour.Persons.Sum(p => p.Weight);
        <div class="tcn-facts">
            @foreach (var p in Tour.Persons.SortedByNameAndDependency())
            {
                <div>@p.Name</div>
                <div>@p.Weight <span class="tcn-hint">@(total == 0 ? 0 : p.Weight * 100 / total)%</span></div>
            }
        </div>
        <div class="tcn-explain-note">
            Every expense shared by everyone is divided in these proportions. A child on 50
            costs half of what an adult on 100 does.
        </div>
    };

    private RenderFragment PersonWeightDetails(Person p) => __builder =>
    {
        var total = Tour.Persons.Sum(x => x.Weight);
        var share = total == 0 ? 0 : p.Weight * 100.0 / total;
        <div class="tcn-facts">
            <div>Weight</div>
            <div>@p.Weight</div>
            <div>Total weight in the tour</div>
            <div>@total</div>
            <div>Share of anything shared by all</div>
            <div>@($"{share:0.0}")%</div>
        </div>
        <div class="tcn-explain-note">
            Out of every 1 000 spent on the whole group, @NewUi.Money((long)Math.Round(share * 10)) lands on @p.Name.
        </div>
    };

    private RenderFragment PersonDebtDetails(Person p, long d, long family) => __builder =>
    {
        var cur = Tour.CurrencyNameEmptyIfSingleCurrency();
        var kids = Tour.Persons.Where(x => x.ParentId == p.GUID).ToList();
        <div class="tcn-facts">
            <div>Paid for the group</div>
            <div>@NewUi.Money(p.SpentInCents)</div>
            <div>Charged for their part</div>
            <div>@NewUi.Money(p.ReceivedInCents)</div>
            <div>Charged − paid</div>
            <div>@NewUi.Money(p.Debt())</div>
            @foreach (var k in kids)
            {
                <div>@k.Name (paid for by @p.Name)</div>
                <div>@NewUi.Money(k.Debt())</div>
            }
            <div><b>Hands over at settle-up</b></div>
            <div><b>@NewUi.Money(family)</b></div>
        </div>
        <div class="tcn-explain-note">
            @if (d == 0)
            {
                <span>Anything under @NewUi.Money(MinMeaningful) @cur counts as settled, so this shows as square.</span>
            }
            else if (d > 0)
            {
                <span>@p.Name used more than they paid for, so the difference is owed to the others.</span>
            }
            else
            {
                <span>@p.Name paid more than they used, so the group owes them the difference.</span>
            }
            @if (Math.Abs(family - d) > _minMeaningful)
            {
                <span>
                    <b>@NewUi.Money(d)</b> of that is @p.Name‘s own;
                    the rest belongs to the people they pay for, and it is settled through them.
                </span>
            }
            The three cells below — Paid, Charged and Balance — open the full itemised lists.
        </div>
    };

    private void ShowEdit(Person person)
    {
        _personToEdit = person;
        _isModalVisible = true;
        StateHasChanged();
    }

    private void SpendFor(Person person)
    {
        AddModal.OpenModal(person.GUID);
    }

    private async Task DeletePerson(Person person)
    {
        var ok = await JsRuntime.InvokeAsync<bool>("confirm", $"Delete '{person.Name}'?");
        if (ok)
        {
            _ = engine.RequestDeletePerson(Tour?.Id, person);
        }
    }

    private Task HandleModalCancel()
    {
        _isModalVisible = false;
        return Task.CompletedTask;
    }

    private async Task HandleModalOk(Person person)
    {
        if (string.IsNullOrWhiteSpace(person.Name))
        {
            await JsRuntime.InvokeVoidAsync("alert", "Person name should not be blank");
            return;
        }
        if (person.GUID == "New")
        {
            // keep the id stable between the local copy and the server one, otherwise
            // a child added right after would attach to the wrong parent
            person.GUID = IdHelper.NewId();
            _ = engine.RequestAddPerson(Tour?.Id, person);
        }
        else
        {
            _ = engine.RequestEditPerson(Tour?.Id, person);
        }
        _isModalVisible = false;
    }
}
