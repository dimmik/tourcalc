@namespace TCBlazor.Client.Components.NewUI

@inject IJSRuntime JsRuntime

@* Hand-written settings screen: the reflection-driven DynaForm can only show
   raw property names, which say nothing about what a setting actually does.
   Each row saves immediately, same as the classic form did. *@

@if (justSaved)
{
    <div class="tcn-savednote">✓ saved</div>
}

<div class="tcn-section">
    <div class="tcn-section-title">Colour</div>
    <div class="tcn-card">
        <div class="tcn-setrow" style="display:block">
            <div class="tcn-settext">
                <div class="tcn-setname">Accent colour</div>
                <div class="tcn-setdesc">
                    The header, the buttons and the highlights. Everything else stays the
                    neutral grey it is now, so this only changes the accent, never the text.
                    The last sample opens the colour picker if none of the seven is the one
                    you want; a very light pick is darkened a little so the white text on
                    top of it stays readable.
                </div>
            </div>
            <div class="tcn-accents" style="margin-top:10px" role="radiogroup" aria-label="Accent colour">
                @foreach (var a in Accents)
                {
                    <button type="button"
                            class="tcn-accent-dot @(Current == a.Key ? "is-on" : "")"
                            style="background: linear-gradient(120deg, @a.From, @a.To)"
                            role="radio"
                            aria-checked=@(Current == a.Key)
                            title="@a.Label"
                            aria-label="@a.Label"
                            @key=@a.Key
                            @onclick=@(() => PickAccent(a.Key))></button>
                }
                <span class="tcn-accent-wrap @(IsCustom ? "is-on" : "")" title="Any other colour">
                    <input type="color"
                           class="tcn-accent-custom"
                           value="@CustomSwatch"
                           role="radio"
                           aria-checked=@IsCustom
                           aria-label="Any other colour"
                           @oninput=@PreviewCustom
                           @onchange=@PickCustom />
                </span>
            </div>
        </div>
    </div>
</div>

<div class="tcn-section">
    <div class="tcn-section-title">Balance &amp; expenses</div>
    <div class="tcn-card">
        <div class="tcn-setrow">
            <div class="tcn-settext">
                <div class="tcn-setname">Ignore debts smaller than</div>
                <div class="tcn-setdesc">
                    Anything below this is treated as settled, so rounding leftovers of a few
                    coins stop showing up as debts.
                </div>
            </div>
            <input class="tcn-input tcn-setnum" type="number" min="0" value=@Settings.MinimumMeaningfulDebt
                   @onchange=@(e => SetInt(v => Settings.MinimumMeaningfulDebt = v, e)) />
        </div>

        <div class="tcn-setrow">
            <div class="tcn-settext">
                <div class="tcn-setname">New expense is for everyone</div>
                <div class="tcn-setdesc">
                    Pre-selects “everyone” when you add an expense. Turn off if most of your
                    spending is for one or two people.
                </div>
            </div>
            <label class="tcn-toggle">
                <input type="checkbox" checked=@Settings.Spending_ToAll_DefaultOn
                       @onchange=@(e => SetBool(v => Settings.Spending_ToAll_DefaultOn = v, e)) />
                <span></span>
            </label>
        </div>

        <div class="tcn-setrow">
            <div class="tcn-settext">
                <div class="tcn-setname">Tap any number for details</div>
                <div class="tcn-setdesc">
                    Turns every figure — totals, balances, counts — into something you can tap
                    to see where it came from. Off by default because it underlines a lot of text.
                </div>
            </div>
            <label class="tcn-toggle">
                <input type="checkbox" checked=@Settings.Explain_Numbers
                       @onchange=@(e => SetBool(v => Settings.Explain_Numbers = v, e)) />
                <span></span>
            </label>
        </div>

        <div class="tcn-setrow">
            <div class="tcn-settext">
                <div class="tcn-setname">Tour links open the expense form</div>
                <div class="tcn-setdesc">
                    Following a shared tour link jumps straight to adding an expense instead of
                    the tour overview.
                </div>
            </div>
            <label class="tcn-toggle">
                <input type="checkbox" checked=@Settings.Default_Tour_Page_Is_Add_Spending
                       @onchange=@(e => SetBool(v => Settings.Default_Tour_Page_Is_Add_Spending = v, e)) />
                <span></span>
            </label>
        </div>
    </div>
</div>

<div class="tcn-section">
    <div class="tcn-section-title">Notifications</div>
    <div class="tcn-card">
        <div class="tcn-setrow">
            <div class="tcn-settext">
                <div class="tcn-setname">Push notifications</div>
                <div class="tcn-setdesc">
                    Shows a subscribe button on each tour, so the browser can notify you when
                    someone else changes it.
                </div>
            </div>
            <label class="tcn-toggle">
                <input type="checkbox" checked=@Settings.Web_Push_Notifications
                       @onchange=@(e => SetBool(v => Settings.Web_Push_Notifications = v, e)) />
                <span></span>
            </label>
        </div>
    </div>
</div>

<div class="tcn-section">
    <div class="tcn-section-title">Charts</div>
    <div class="tcn-card">
        <div class="tcn-setrow">
            <div class="tcn-settext">
                <div class="tcn-setname">Colour scheme</div>
                <div class="tcn-setdesc">
                    Seed number for the pie chart palette on the Stats tab. Change it if two
                    categories end up looking alike.
                </div>
            </div>
            <input class="tcn-input tcn-setnum" type="number" value=@Settings.Magic_Piechart_Color_Scheme_Number
                   @onchange=@(e => SetInt(v => Settings.Magic_Piechart_Color_Scheme_Number = v, e)) />
        </div>

        <div class="tcn-setrow">
            <div class="tcn-settext">
                <div class="tcn-setname">Show colour controls on the chart</div>
                <div class="tcn-setdesc">Adds the seed colour picker next to the pie chart.</div>
            </div>
            <label class="tcn-toggle">
                <input type="checkbox" checked=@Settings.Show_Debug_UI
                       @onchange=@(e => SetBool(v => Settings.Show_Debug_UI = v, e)) />
                <span></span>
            </label>
        </div>
    </div>
</div>

<div class="tcn-section">
    <div class="tcn-section-title">Classic interface only</div>
    <div class="tcn-card">
        <div class="tcn-sethint">These three change nothing while the new interface is on.</div>

        <div class="tcn-setrow">
            <div class="tcn-settext">
                <div class="tcn-setname">Bulk category change</div>
                <div class="tcn-setdesc">Adds checkboxes to the classic expense list for changing many categories at once.</div>
            </div>
            <label class="tcn-toggle">
                <input type="checkbox" checked=@Settings.Show_Mass_Spending_Change
                       @onchange=@(e => SetBool(v => Settings.Show_Mass_Spending_Change = v, e)) />
                <span></span>
            </label>
        </div>

        <div class="tcn-setrow">
            <div class="tcn-settext">
                <div class="tcn-setname">Collapse the people table on narrow screens</div>
                <div class="tcn-setdesc">Hides the weight / spent / received columns in the classic people list.</div>
            </div>
            <label class="tcn-toggle">
                <input type="checkbox" checked=@Settings.Collapse_Columns_In_Person_List_On_Smaller_Screen
                       @onchange=@(e => SetBool(v => Settings.Collapse_Columns_In_Person_List_On_Smaller_Screen = v, e)) />
                <span></span>
            </label>
        </div>

        <div class="tcn-setrow">
            <div class="tcn-settext">
                <div class="tcn-setname">“Narrow screen” width</div>
                <div class="tcn-setdesc">Below this many pixels the columns above collapse.</div>
            </div>
            <input class="tcn-input tcn-setnum" type="number" min="0" value=@Settings.Smaller_Screen_Width
                   @onchange=@(e => SetInt(v => Settings.Smaller_Screen_Width = v, e)) />
        </div>
    </div>
</div>

@code {
    [Parameter]
    public UISettings Settings { get; set; } = new();

    [Parameter]
    public EventCallback<UISettings> OnSave { get; set; }

    private bool justSaved = false;

    /// <summary>
    /// The seven the stylesheet knows about. From / To are the real gradient stops, so the
    /// sample is the colour you actually get rather than an approximation of it.
    /// </summary>
    private record Accent(string Key, string Label, string From, string To);

    private static readonly Accent[] Accents = new[]
    {
        new Accent("indigo",   "Indigo (default)", "#4f46e5", "#6d28d9"),
        new Accent("blue",     "Ocean",            "#2563eb", "#226c91"),
        new Accent("teal",     "Teal",             "#0f766e", "#226881"),
        new Accent("green",    "Forest",           "#15803d", "#1b6a5a"),
        new Accent("plum",     "Plum",             "#7e22ce", "#8d358d"),
        new Accent("crimson",  "Crimson",          "#b91c1c", "#922a51"),
        new Accent("graphite", "Graphite",         "#475569", "#425367"),
    };

    /// <summary>The preset that is showing, or "" when the colour was picked by hand -
    /// otherwise a hex value would fall back to indigo and light up that dot as well.</summary>
    private string Current =>
        IsCustom ? ""
        : Accents.Any(a => a.Key == Settings.Accent_Colour) ? Settings.Accent_Colour
        : "indigo";

    /// <summary>
    /// Anything that is not one of the seven keys is a hex colour chosen by hand; the
    /// stylesheet has no block for those, so tcSetAccent derives the variables instead.
    /// </summary>
    private bool IsCustom => (Settings.Accent_Colour ?? "").StartsWith("#");

    /// <summary>What the native picker opens on: the hand-picked colour, or, if there is
    /// none yet, the first stop of the theme currently in use.</summary>
    private string CustomSwatch =>
        IsCustom ? Settings.Accent_Colour : Accents.First(a => a.Key == Current).From;

    private async Task PickAccent(string key)
    {
        Settings.Accent_Colour = key;
        // repaint before saving: the point of a colour picker is that you see it at once
        try { await JsRuntime.InvokeVoidAsync("tcSetAccent", key); } catch { }
        await Save();
    }

    /// <summary>Dragging inside the picker repaints the page live. Nothing is written
    /// until it closes, so backing out of the dialog leaves the setting alone.</summary>
    private async Task PreviewCustom(ChangeEventArgs e)
    {
        var hex = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(hex)) return;
        try { await JsRuntime.InvokeVoidAsync("tcSetAccent", hex); } catch { }
    }

    private async Task PickCustom(ChangeEventArgs e)
    {
        var hex = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(hex)) return;
        Settings.Accent_Colour = hex;
        try { await JsRuntime.InvokeVoidAsync("tcSetAccent", hex); } catch { }
        await Save();
    }

    private async Task SetBool(Action<bool> apply, ChangeEventArgs e)
    {
        apply((bool)(e.Value ?? false));
        await Save();
    }

    private async Task SetInt(Action<int> apply, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v))
        {
            apply(v);
            await Save();
        }
    }

    // every row saves on change, and until now it did so completely silently
    private async Task Save()
    {
        await OnSave.InvokeAsync(Settings);
        justSaved = true;
        StateHasChanged();
        await Task.Delay(1400);
        justSaved = false;
        StateHasChanged();
    }
}
