@namespace TCBlazor.Client.Components.NewUI

@using TCalc.Logic
@using TCalcCore.Engine

@inject TourcalcEngine engine
@inject IJSRuntime JsRuntime

@{
    var transfers = Transfers().ToList();
    var familyTransfers = FamilyTransfers().ToList();
    var curName = Tour.CurrencyNameEmptyIfSingleCurrency();
}

<div class="tcn-section">
    @if (!transfers.Any())
    {
        <div class="tcn-allsettled">
            <div class="tcn-allsettled-icon">🎉</div>
            <div class="tcn-allsettled-title">Everyone is settled up</div>
            <div class="tcn-allsettled-sub">
                @if (!Tour.Spendings.Any(s => !s.Planned))
                {
                    <span>Add the first expense and the split will show up here.</span>
                }
                else
                {
                    <span>No payments are left between the participants.</span>
                }
            </div>
        </div>
    }
    else
    {
        <div class="tcn-section-title">
            Who pays whom <span class="tcn-count">@transfers.Count</span>
        </div>
        <div class="tcn-hint" style="margin: -4px 2px 10px 2px">
            Nothing here is paid yet — these are the payments that would square everyone up.
        </div>
        <div class="tcn-list">
            @foreach (var s in transfers)
            {
                var from = Tour.Persons.FirstOrDefault(p => p.GUID == s.FromGuid);
                var to = Tour.Persons.FirstOrDefault(p => p.GUID == s.ToGuid.FirstOrDefault());
                <div class="tcn-settle" @key=@($"tr_{s.GUID}")>
                    <div class="tcn-settle-flow">
                        <span class="tcn-avatar tcn-avatar-sm" style="background:@NewUi.AvatarColor(from?.Name)">@NewUi.Initials(from?.Name, Tour)</span>
                        <span class="tcn-settle-who">@(from?.Name ?? "n/a")</span>
                        <span class="tcn-settle-arrow"><TcIcon Name="arrow-right" /></span>
                        <span class="tcn-avatar tcn-avatar-sm" style="background:@NewUi.AvatarColor(to?.Name)">@NewUi.Initials(to?.Name, Tour)</span>
                        <span class="tcn-settle-who">@(to?.Name ?? "n/a")</span>
                    </div>
                    <div class="tcn-settle-amount">
                        <Explain Enabled=@Explainable Title="Why this payment"
                                 Headline=@($"{NewUi.Money(s.AmountInCurrentCurrency(Tour))} {curName}")
                                 Details=@TransferDetails(s)>
                            @NewUi.Money(s.AmountInCurrentCurrency(Tour))
                        </Explain>
                        @if (!string.IsNullOrEmpty(curName))
                        {
                            <small>&nbsp;@curName</small>
                        }
                    </div>
                    <button type="button" class="tcn-btn tcn-btn-sm tcn-btn-settle"
                            title="Record that this money has actually changed hands"
                            @onclick=@(() => MarkPaid(s))>
                        Mark paid
                    </button>
                </div>
            }
        </div>
    }
</div>

@if (familyTransfers.Any())
{
    <div class="tcn-section">
        <div class="tcn-section-title">
            <span class="tcn-btn tcn-btn-ghost tcn-btn-sm" @onclick=@(() => showFamily = !showFamily)>
                <TcIcon Name=@(showFamily ? "chevron-down" : "chevron-right") /> Inside families
            </span>
            <span class="tcn-count">@familyTransfers.Count</span>
        </div>
        @if (showFamily)
        {
            <div class="tcn-list">
                @foreach (var s in familyTransfers)
                {
                    var from = Tour.Persons.FirstOrDefault(p => p.GUID == s.FromGuid);
                    var to = Tour.Persons.FirstOrDefault(p => p.GUID == s.ToGuid.FirstOrDefault());
                    <div class="tcn-settle" @key=@($"ftr_{s.GUID}")>
                        <div class="tcn-settle-flow">
                            <span class="tcn-avatar tcn-avatar-sm" style="background:@NewUi.AvatarColor(from?.Name)">@NewUi.Initials(from?.Name, Tour)</span>
                            <span class="tcn-settle-who">@(from?.Name ?? "n/a")</span>
                            <span class="tcn-settle-arrow"><TcIcon Name="arrow-right" /></span>
                            <span class="tcn-avatar tcn-avatar-sm" style="background:@NewUi.AvatarColor(to?.Name)">@NewUi.Initials(to?.Name, Tour)</span>
                            <span class="tcn-settle-who">@(to?.Name ?? "n/a")</span>
                        </div>
                        <div class="tcn-settle-amount">@NewUi.Money(s.AmountInCurrentCurrency(Tour))</div>
                    </div>
                }
            </div>
        }
    </div>
}

@{
    var balances = Balances().ToList();
    var scale = balances.Any() ? balances.Max(b => Math.Abs(b.amount)) : 0;
    if (scale == 0) scale = 1;
}
@if (balances.Any())
{
    <div class="tcn-section">
        <div class="tcn-section-title">Balances</div>
        <div class="tcn-card" style="padding: 12px;">
            @foreach (var b in balances)
            {
                <div style="margin-bottom: 12px;" @key=@($"bal_{b.person.GUID}")>
                    <div class="tcn-bal-row">
                        <span class="tcn-avatar tcn-avatar-sm" style="background:@NewUi.AvatarColor(b.person.Name)">@NewUi.Initials(b.person.Name, Tour)</span>
                        <span class="tcn-bal-name">@b.person.Name</span>
                        <span class="tcn-bal-amount @(b.amount > 0 ? "tcn-neg" : b.amount < 0 ? "tcn-pos" : "")">
                            <Explain Enabled=@Explainable Title=@($"{b.person.Name}: how this balance is made")
                                     Headline=@(b.amount > 0 ? $"owes {NewUi.Money(b.amount)} {curName}" : b.amount < 0 ? $"gets {NewUi.Money(-b.amount)} {curName}" : "settled")
                                     Details=@PersonBalanceDetails(b.person)>
                                @if (b.amount > 0)
                                {
                                    <span>owes @NewUi.Money(b.amount)</span>
                                }
                                else if (b.amount < 0)
                                {
                                    <span>gets @NewUi.Money(-b.amount)</span>
                                }
                                else
                                {
                                    <span style="color: var(--tcn-faint)">settled</span>
                                }
                            </Explain>
                        </span>
                    </div>
                    <div class="tcn-balancebar">
                        <div class="tcn-balancebar-neg">
                            @if (b.amount < 0)
                            {
                                <i style="width:@(Pct(-b.amount, scale))%"></i>
                            }
                        </div>
                        <div class="tcn-balancebar-mid"></div>
                        <div class="tcn-balancebar-pos">
                            @if (b.amount > 0)
                            {
                                <i style="width:@(Pct(b.amount, scale))%"></i>
                            }
                        </div>
                    </div>
                </div>
            }
            <div style="display:flex; justify-content:space-between; font-size:11px; color: var(--tcn-faint); text-transform:uppercase; letter-spacing:.5px;">
                <span>gets money back</span>
                <span>owes money</span>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Tour Tour { get; set; } = new();

    [Parameter]
    public UISettings Settings { get; set; } = new();

    private bool showFamily = false;

    private long MinMeaningful => Tour.GetAmountInCurrentCurrencyFromMinValued(Settings.MinimumMeaningfulDebt);

    // the threshold is hoisted: as a property it was re-evaluated for every element,
    // and each evaluation reaches into Tour.Currency and scans all currencies
    private IEnumerable<Spending> Transfers()
    {
        var min = MinMeaningful;
        return (Tour?.Spendings ?? new List<Spending>())
            .Where(s => s.Planned && !s.Description.StartsWith("Family"))
            .Select(s => (sp: s, amount: s.AmountInCurrentCurrency(Tour)))
            .Where(x => Math.Abs(x.amount) > min)
            .OrderByDescending(x => x.amount)
            .Select(x => x.sp)
            .ToList();
    }

    private IEnumerable<Spending> FamilyTransfers()
    {
        var min = MinMeaningful;
        return (Tour?.Spendings ?? new List<Spending>())
            .Where(s => s.Planned && s.Description.StartsWith("Family"))
            .Select(s => (sp: s, amount: s.AmountInCurrentCurrency(Tour)))
            .Where(x => Math.Abs(x.amount) > min)
            .OrderByDescending(x => x.amount)
            .Select(x => x.sp)
            .ToList();
    }

    private IEnumerable<(Person person, long amount)> Balances()
    {
        var min = MinMeaningful;
        return (Tour?.Persons ?? new List<Person>())
            .Where(p => string.IsNullOrWhiteSpace(p.ParentId))
            .Select(p => (person: p, amount: Tour.AmountAPersonWillPay(p)))
            .Where(pa => Math.Abs(pa.amount) > min)
            .OrderByDescending(pa => pa.amount)
            .ToList();
    }

    private static int Pct(long value, long scale) => (int)Math.Round(Math.Min(100.0, value * 100.0 / scale));

    private bool Explainable => Settings.Explain_Numbers;

    private RenderFragment TransferDetails(Spending s) => __builder =>
    {
        var cur = Tour.CurrencyNameEmptyIfSingleCurrency();
        var from = Tour.Persons.FirstOrDefault(p => p.GUID == s.FromGuid);
        var to = Tour.Persons.FirstOrDefault(p => p.GUID == s.ToGuid.FirstOrDefault());
        <div class="tcn-facts">
            <div>Pays</div>
            <div>@(from?.Name ?? "n/a")</div>
            <div>Receives</div>
            <div>@(to?.Name ?? "n/a")</div>
            @if (from != null)
            {
                <div>@from.Name paid in total</div>
                <div>@NewUi.Money(from.SpentInCents)</div>
                <div>@from.Name was charged</div>
                <div>@NewUi.Money(from.ReceivedInCents)</div>
            }
            @if (to != null)
            {
                <div>@to.Name paid in total</div>
                <div>@NewUi.Money(to.SpentInCents)</div>
                <div>@to.Name was charged</div>
                <div>@NewUi.Money(to.ReceivedInCents)</div>
            }
        </div>
        <div class="tcn-explain-note">
            Nobody chose this payment — it is one of the transfers the app picked to square everyone
            up with as few payments as possible. It has not happened yet: “Mark paid” is what records it,
            after which both balances move towards zero.
        </div>
    };

    private RenderFragment PersonBalanceDetails(Person p) => __builder =>
    {
        var cur = Tour.CurrencyNameEmptyIfSingleCurrency();
        var kids = Tour.Persons.Where(x => x.ParentId == p.GUID).ToList();
        <div class="tcn-facts">
            <div>Paid for the group</div>
            <div>@NewUi.Money(p.SpentInCents)</div>
            <div>Charged for their part</div>
            <div>@NewUi.Money(p.ReceivedInCents)</div>
            <div>Difference</div>
            <div>@NewUi.Money(p.Debt())</div>
            @foreach (var k in kids)
            {
                <div>+ @k.Name (paid for by @p.Name)</div>
                <div>@NewUi.Money(k.Debt())</div>
            }
            <div>Net to settle</div>
            <div>@NewUi.Money(Tour.AmountAPersonWillPay(p))</div>
        </div>
        <div class="tcn-explain-note">
            What they were charged minus what they paid. A positive number means their part of
            the spending cost more than they put in, so they owe;
            @if (kids.Any())
            {
                <span> the people they cover are rolled into their net figure;</span>
            }
            a negative one means the group owes them.
        </div>
    };

    private async Task MarkPaid(Spending s)
    {
        var from = NewUi.PersonName(Tour, s.FromGuid);
        var to = NewUi.PersonName(Tour, s.ToGuid.FirstOrDefault());
        var amount = NewUi.Money(s.AmountInCurrentCurrency(Tour));
        bool ok = await JsRuntime.InvokeAsync<bool>("confirm", $"Record that {from} paid {amount} to {to}?");
        if (!ok) return;
        var ss = s.SafeClone<Spending>();
        ss.Type = "";
        ss.Color = ss.Description.StartsWith("X") ? "lightgreen" : "lightgray";
        _ = engine.RequestAddSpending(Tour?.Id, ss);
    }
}
