@namespace TCBlazor.Client.Components.NewUI

@using TCalc.Logic
@using TCalcCore.Engine

@inject TourcalcEngine engine
@inject IJSRuntime JsRuntime

@implements IDisposable

@{
    var curName = Tour.CurrencyNameEmptyIfSingleCurrency();
    var realSpendings = Tour.Spendings.Where(s => !s.Planned).ToList();
    var totalSpent = realSpendings
        .Where(s => !string.IsNullOrWhiteSpace(s.Type) && (!s.IsDryRun || s.IncludeDryRunInCalc))
        .Sum(s => s.AmountInCurrentCurrency(Tour));
    var minMeaningful = Tour.GetAmountInCurrentCurrencyFromMinValued(Settings.MinimumMeaningfulDebt);
    var openTransfers = Tour.Spendings
        .Where(s => s.Planned && !s.Description.StartsWith("Family"))
        .Where(s => Math.Abs(s.AmountInCurrentCurrency(Tour)) > minMeaningful)
        .ToList();
    var leftToSettle = openTransfers.Sum(s => s.AmountInCurrentCurrency(Tour));
}

<div class="tcn-hero">
    <div class="tcn-hero-top">
        <div class="tcn-hero-name">@Tour.Name</div>
        <TourEditModal Tour=@RawTour @key=@($"ed_{Tour.Id}") />
        <button type="button" class="tcn-iconbtn" title="Reload from the server" aria-label="Reload from the server"
                disabled=@reloading @onclick=@Reload>
            <span class="@(reloading ? "tcn-spin" : "")">⟳</span>
        </button>
    </div>
    <div class="tcn-hero-sub">
        <TourFreshness IsFresh=@IsFresh StoredDt=@StoredDt Reloading=@reloading
                       Outcome=@((TourFreshness.RefreshOutcome)(int)outcome) />
        <span>·</span>
        <span><CurrenciesModalNew tour=@RawTour @key=@($"cur_{Tour.Id}") /></span>
        <span>·</span>
        <ShareLinkButton Tour=@RawTour @key=@($"share_{Tour.Id}") />
        <span>·</span>
        <span class="tcn-legacy-btn"><TourVersions @key=@($"tvn_{Tour.Id}") Tour=@RawTour Text="versions" /></span>
        <PushSubscribeButton Tour=@RawTour @key=@($"push_{Tour.Id}") />
    </div>

    @if (RawTour.IsMultiCurrency())
    {
        <div class="tcn-hero-sub" style="margin-top:8px">
            <span title="Only changes what you see - the tour itself is not touched">show amounts in</span>
            <select class="tcn-input" style="width:auto; padding:4px 8px; font-size:13px;"
                    value="@(SelectedCurrency?.Id ?? "")"
                    @onchange=@OnCurrencyPicked>
                @foreach (var c in RawTour.Currencies)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>
        </div>
    }

    <div class="tcn-hero-metrics">
        <div class="tcn-metric">
            <div class="tcn-metric-label">Total spent</div>
            <div class="tcn-metric-value">
                <Explain Enabled=@Explainable Title="Total spent" Headline=@($"{NewUi.Money(totalSpent)} {curName}")
                         Details=@TotalSpentDetails>
                    @NewUi.Money(totalSpent)
                </Explain>
                <small>@curName</small>
            </div>
        </div>
        <div class="tcn-metric">
            <div class="tcn-metric-label">People</div>
            <div class="tcn-metric-value">
                <Explain Enabled=@Explainable Title="People in this tour" Headline=@($"{Tour.Persons.Count} people")
                         Details=@PeopleDetails>
                    @Tour.Persons.Count
                </Explain>
            </div>
        </div>
        <div class="tcn-metric">
            <div class="tcn-metric-label">Expenses</div>
            <div class="tcn-metric-value">
                <Explain Enabled=@Explainable Title="Recorded expenses" Headline=@($"{realSpendings.Count} entries")
                         Details=@ExpensesDetails>
                    @realSpendings.Count
                </Explain>
            </div>
        </div>
        <div class="tcn-metric">
            <div class="tcn-metric-label">Left to settle</div>
            <div class="tcn-metric-value">
                <Explain Enabled=@Explainable Title="Left to settle"
                         Headline=@(openTransfers.Any() ? $"{NewUi.Money(leftToSettle)} {curName}" : "Nothing left")
                         Details=@SettleDetails>
                    @if (openTransfers.Any())
                    {
                        <span>@NewUi.Money(leftToSettle) <small>@curName</small></span>
                    }
                    else
                    {
                        <span>all done ✓</span>
                    }
                </Explain>
            </div>
        </div>
    </div>
</div>

<nav class="tcn-tabs" role="tablist" aria-label="Tour sections">
    <button type="button" role="tab" aria-selected=@(tab == Tab.Balance) class="tcn-tab @(tab == Tab.Balance ? "is-active" : "")" @onclick=@(() => tab = Tab.Balance)>
        Balance
        @if (openTransfers.Any())
        {
            <span class="tcn-tab-badge">@openTransfers.Count</span>
        }
    </button>
    <button type="button" role="tab" aria-selected=@(tab == Tab.People) class="tcn-tab @(tab == Tab.People ? "is-active" : "")" @onclick=@(() => tab = Tab.People)>
        People <span class="tcn-tab-badge">@Tour.Persons.Count</span>
    </button>
    <button type="button" role="tab" aria-selected=@(tab == Tab.Expenses) class="tcn-tab @(tab == Tab.Expenses ? "is-active" : "")" @onclick=@(() => tab = Tab.Expenses)>
        Expenses <span class="tcn-tab-badge">@realSpendings.Count</span>
    </button>
    <button type="button" role="tab" aria-selected=@(tab == Tab.Stats) class="tcn-tab @(tab == Tab.Stats ? "is-active" : "")" @onclick=@(() => tab = Tab.Stats)>
        Stats
    </button>
</nav>

@if (tab == Tab.Balance)
{
    <BalanceTab Tour=@Tour Settings=@Settings />
}
else if (tab == Tab.People)
{
    <PeopleTab Tour=@Tour Settings=@Settings AddModal=@AddModal />
}
else if (tab == Tab.Expenses)
{
    <ExpensesTab Tour=@Tour RawTour=@RawTour Settings=@Settings />
}
else
{
    <StatsTab Tour=@Tour />
}

<button type="button" class="tcn-fab" aria-label="Add an expense" @onclick=@AddSpending>
    <span style="font-size:18px; line-height:1">＋</span> Spend
</button>

@code {
    /// <summary>Tour converted into the currency the user picked for display.</summary>
    [Parameter]
    public Tour Tour { get; set; } = new();

    /// <summary>Tour as loaded - edit forms must see the original currencies.</summary>
    [Parameter]
    public Tour RawTour { get; set; } = new();

    [Parameter]
    public UISettings Settings { get; set; } = new();

    [Parameter]
    public bool IsFresh { get; set; }

    [Parameter]
    public DateTimeOffset StoredDt { get; set; } = DateTimeOffset.Now;

    [Parameter]
    public Currency? SelectedCurrency { get; set; }

    [Parameter]
    public EventCallback<Currency?> OnCurrencyChanged { get; set; }

    [Parameter]
    public SpendingAddInModal AddModal { get; set; } = new();

    [Parameter]
    public Func<Task<string?>> GetDefaultPayer { get; set; } = () => Task.FromResult<string?>(null);

    private bool Explainable => Settings.Explain_Numbers;

    /// <summary>Rounding a small slice to "0%" reads as "nothing", which it is not.</summary>
    private static string Percent(long part, long whole)
    {
        if (whole == 0) return "0%";
        var p = part * 100.0 / whole;
        if (p > 0 && p < 1) return "<1%";
        return $"{Math.Round(p)}%";
    }

    private RenderFragment TotalSpentDetails => __builder =>
    {
        var counted = Tour.Spendings.Where(s => !s.Planned && !string.IsNullOrWhiteSpace(s.Type) && (!s.IsDryRun || s.IncludeDryRunInCalc)).ToList();
        var total = counted.Sum(s => s.AmountInCurrentCurrency(Tour));
        var skipped = Tour.Spendings.Count(s => !s.Planned) - counted.Count;
        var byCat = counted.GroupBy(s => s.Type).Select(g => (Cat: g.Key, Sum: g.Sum(x => x.AmountInCurrentCurrency(Tour)))).OrderByDescending(x => x.Sum).ToList();
        <div class="tcn-facts">
            @foreach (var c in byCat)
            {
                <div>@c.Cat <span class="tcn-hint">@Percent(c.Sum, total)</span></div>
                <div>@NewUi.Money(c.Sum)</div>
            }
        </div>
        <div class="tcn-explain-note">
            Adds up every expense that has a category and is not a draft.
            @if (skipped > 0)
            {
                <span> @skipped entr@(skipped == 1 ? "y is" : "ies are") left out — paybacks and drafts do not count as spending.</span>
            }
        </div>
    };

    private RenderFragment PeopleDetails => __builder =>
    {
        var totalWeight = Tour.Persons.Sum(p => p.Weight);
        <div class="tcn-facts">
            @foreach (var p in Tour.Persons.SortedByNameAndDependency())
            {
                <div>
                    @p.Name
                    @if (!string.IsNullOrWhiteSpace(p.ParentId))
                    {
                        <span class="tcn-hint"> · paid for by @NewUi.PersonName(Tour, p.ParentId)</span>
                    }
                </div>
                <div>@p.Weight <span class="tcn-hint">@Percent(p.Weight, totalWeight)</span></div>
            }
        </div>
        <div class="tcn-explain-note">
            Weights decide how a shared expense is split: total weight here is @totalWeight,
            so someone on 100 carries @(totalWeight == 0 ? 0 : 100 * 100 / totalWeight)% of anything shared by everyone.
        </div>
    };

    private RenderFragment ExpensesDetails => __builder =>
    {
        var real = Tour.Spendings.Where(s => !s.Planned).ToList();
        var drafts = real.Count(s => s.IsDryRun);
        var paybacks = real.Count(s => s.Description.StartsWith("X "));
        var family = real.Count(s => s.Description.StartsWith("Family "));
        var counted = real.Count(s => !string.IsNullOrWhiteSpace(s.Type) && (!s.IsDryRun || s.IncludeDryRunInCalc));
        <div class="tcn-facts">
            <div>Counted as spending</div>
            <div>@counted</div>
            <div>Drafts</div>
            <div>@drafts</div>
            <div>Paybacks (X …)</div>
            <div>@paybacks</div>
            <div>Inside families</div>
            <div>@family</div>
            @if (real.Any())
            {
                <div>First</div>
                <div>@real.Min(s => s.SpendingDate).ToString("dd.MM.yyyy")</div>
                <div>Last</div>
                <div>@real.Max(s => s.SpendingDate).ToString("dd.MM.yyyy")</div>
                <div>Average entry</div>
                <div>@NewUi.Money(real.Sum(s => s.AmountInCurrentCurrency(Tour)) / real.Count)</div>
            }
        </div>
    };

    private RenderFragment SettleDetails => __builder =>
    {
        var minMeaningful = Tour.GetAmountInCurrentCurrencyFromMinValued(Settings.MinimumMeaningfulDebt);
        var transfers = Tour.Spendings
            .Where(s => s.Planned && !s.Description.StartsWith("Family"))
            .Where(s => Math.Abs(s.AmountInCurrentCurrency(Tour)) > minMeaningful)
            .OrderByDescending(s => s.AmountInCurrentCurrency(Tour)).ToList();
        if (!transfers.Any())
        {
            <div class="tcn-explain-note">Everyone is square — no payments are left between the participants.</div>
        }
        else
        {
            <div class="tcn-facts">
                @foreach (var t in transfers)
                {
                    <div>@NewUi.PersonName(Tour, t.FromGuid) → @NewUi.PersonName(Tour, t.ToGuid.FirstOrDefault())</div>
                    <div>@NewUi.Money(t.AmountInCurrentCurrency(Tour))</div>
                }
            </div>
            <div class="tcn-explain-note">
                @transfers.Count payment@(transfers.Count == 1 ? "" : "s") would even everyone out.
                Anything under @NewUi.Money(minMeaningful) @Tour.CurrencyNameEmptyIfSingleCurrency() is treated as settled.
            </div>
        }
    };

    /// <summary>"persons" / "spendings" - the legacy per-section routes land on the matching tab.</summary>
    [Parameter]
    public string? InitialSection { get; set; }

    private enum Tab { Balance, People, Expenses, Stats }
    private Tab tab = Tab.Expenses;
    private bool reloading = false;

    private enum RefreshOutcome { None, Updated, UpToDate, Failed }
    private RefreshOutcome outcome = RefreshOutcome.None;

    // set from the engine callback: it fires only when the server actually returned a tour
    private bool serverAnswered = false;
    private Tour? serverTour = null;
    private bool tabInitialized = false;

    protected override void OnParametersSet()
    {
        if (!tabInitialized)
        {
            tab = InitialSection switch
            {
                "persons" => Tab.People,
                "spendings" => Tab.Expenses,
                // a tour that is being settled up opens on the payments,
                // any other one opens where the expenses are added
                _ => (RawTour.IsFinalizing && !RawTour.IsArchived) ? Tab.Balance : Tab.Expenses,
            };
            tabInitialized = true;
        }
    }

    private async Task Reload()
    {
        if (reloading) return;
        reloading = true;
        outcome = RefreshOutcome.None;
        serverAnswered = false;
        serverTour = null;
        var before = Fingerprint(RawTour);
        var started = DateTime.UtcNow;

        await engine.RequestTourLoad(RawTour.Id, forceLoadFromServer: true);

        // the call is awaited all the way down, so by now the callback has run - or never will
        outcome = !serverAnswered
            ? RefreshOutcome.Failed
            : Fingerprint(serverTour) == before ? RefreshOutcome.UpToDate : RefreshOutcome.Updated;

        // a local server answers in milliseconds - hold the spinner long enough to be seen
        var minVisible = TimeSpan.FromMilliseconds(450);
        var elapsed = DateTime.UtcNow - started;
        if (elapsed < minVisible) await Task.Delay(minVisible - elapsed);
        reloading = false;
        StateHasChanged();

        // a failure deserves a longer look than a success
        var shown = outcome == RefreshOutcome.Failed ? 5000 : 2200;
        var mine = outcome;
        await Task.Delay(shown);
        if (outcome == mine)
        {
            outcome = RefreshOutcome.None;
            StateHasChanged();
        }
    }

    private Task OnAnyTourLoaded(Tour t, bool isFromServer, DateTimeOffset dt)
    {
        if (isFromServer)
        {
            serverAnswered = true;
            serverTour = t;
        }
        return Task.CompletedTask;
    }

    /// <summary>Cheap "did anything actually change" stamp - counts and totals catch any real edit.</summary>
    private static string Fingerprint(Tour? t)
    {
        if (t == null) return "";
        var sp = t.Spendings ?? new List<Spending>();
        return string.Join("|",
            t.Name,
            t.Persons?.Count ?? 0,
            sp.Count,
            sp.Sum(x => x.AmountInCents),
            t.Duration, t.IsFinalizing, t.IsArchived, t.TourCurrencyId);
    }

    protected override void OnInitialized()
    {
        engine.onTourLoaded += OnAnyTourLoaded;
    }

    public void Dispose()
    {
        engine.onTourLoaded -= OnAnyTourLoaded;
    }

    private async Task AddSpending()
    {
        AddModal.OpenModal(await GetDefaultPayer());
    }

    private async Task OnCurrencyPicked(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        var c = RawTour.Currencies.FirstOrDefault(cc => cc.Id == id);
        await OnCurrencyChanged.InvokeAsync(c);
    }
}
