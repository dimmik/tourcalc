@using TCalcCore.Engine
@inject TourcalcEngine engine

@inject IJSRuntime JsRuntime

<Button Danger Type="@ButtonType.Dashed" Shape="@ButtonShape.Round" @onclick=@(() => open = !open)>Balance</Button>

<Modal Title=@($"Tour Balance for '{tour?.Name}'")
Visible="@open"
OnOk=@(() => open = false)
OnCancel=@(() => open = false)
DestroyOnClose=@true
Closable=@true>
    <TableTemplateDiv
    Items=@balanceS
    Context="spendingItem"
    >
        <TableHeader>
            <div class="grid-header">From</div>
            <div class="grid-header">To</div>
            <div class="grid-header">Amount</div>
        </TableHeader>
        <RowTemplate>
            @{
                var spending = spendingItem.Item1;
                var idx = spendingItem.Item2;
                var tourCurrencies = tour?.Currencies ?? new Currency[0];
                var currencies = spending.Currencies.Any() ? spending.Currencies : tourCurrencies;
                var curr = currencies.Where(c => c == spending.Currency)?.FirstOrDefault() ?? Currency.Default;
                var tourCurr = currencies.Where(c => c == (tour?.Currency ?? Currency.Default))?.FirstOrDefault() ??
                    (tourCurrencies.Where(c => c == (tour?.Currency ?? Currency.Default))?.FirstOrDefault() ?? Currency.Default);
            }
            <div class="grid-cell" style="background-color: @(idx%2 == 0 ? "#FFCCCB" : "#FFD1DC")">@((MarkupString)(tour?.Persons?.Where(p => p.GUID == spending.FromGuid)?.FirstOrDefault()?.Name ?? "n/a").AsBreakable())</div>
            <div class="grid-cell" style="background-color: @(idx%2 == 0 ? "#CCFFCB" : "#D1FFDC")">@((MarkupString)(tour?.Persons?.Where(p => p.GUID == spending.ToGuid.FirstOrDefault())?.FirstOrDefault()?.Name ?? "n/a").AsBreakable())</div>
            <div class="grid-cell balance" style="background-color: @(idx%2 == 0 ? "#E6E6E6" : "#E9E9E9")">
                <b>@spending.AmountInCurrentCurrency(tour).ToString("N0", GlobConsts.NumGroupSpaceSeparated) </b>
                @if (tour?.IsMultiCurrency() ?? false)
                {
                    <small>@(" ")@curr.Name</small>
                }
                <Button Danger Size="small" @onclick=@(async () => {
                            bool confirmed = await JsRuntime.InvokeAsync<bool>("confirm", $"Add planned '{spending.Description}' : {spending.AmountInCurrentCurrency(tour)}?");
                            if (confirmed)
                            {
                                var ss = spending.SafeClone<Spending>();
                                ss.Type = "";
                                ss.Color = ss.Description.StartsWith("X") ? "lightgreen" : "lightgray";
                                _ = engine.RequestAddSpending(tour?.Id, ss);
                            }
                        })>
                    +
                </Button>
            </div>
        </RowTemplate>
    </TableTemplateDiv>
</Modal>

@code {
    public bool open { get; set; } = false;
    [Parameter]
    public Tour? tour { get; set; }

    private IEnumerable<Spending> balanceS = [];

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (tour is not null)
        {
            balanceS = tour.Spendings.Where(s => s.Planned && !s.Description.StartsWith("Family"));
        } else
        {
            balanceS = [];
        }
    }
}
