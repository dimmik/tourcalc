@inject IJSRuntime _jsRuntime
@inject UiModeService uiMode
@inject ILocalLogger logger


@if (_newVersionAvailable)
{
    @if (uiMode.IsNew)
    {
        @* an offer, never a demand - reloading is up to the user *@
        <button type="button" class="tcn-update" onclick="window.location.reload()"
                title="A new version is ready. Reload whenever it suits you - nothing is lost if you wait.">
            <span class="tcn-update-dot"></span>Update
        </button>
    }
    else
    {
        <button style="background-color: Beige; color:darkgreen" onclick="window.location.reload()">
            update
        </button>
    }
}

@code {

    private bool _newVersionAvailable = false;

    protected override async Task OnInitializedAsync()
    {
        await RegisterForUpdateAvailableNotification();
    }
    private async Task RegisterForUpdateAvailableNotification()
    {
        logger.Log(nameof(RegisterForUpdateAvailableNotification));
        await _jsRuntime.InvokeAsync<object>(
            identifier: "registerForUpdateAvailableNotification",
            DotNetObjectReference.Create(this),
            nameof(OnUpdateAvailable));
    }

    [JSInvokable(nameof(OnUpdateAvailable))]
    public Task OnUpdateAvailable()
    {
        if (!_newVersionAvailable)
        {
            logger.Log("Update available. Show update button!");
            _newVersionAvailable = true;
            StateHasChanged();
        } else
        {
            // nothing
        }


        return Task.CompletedTask;
    }

}