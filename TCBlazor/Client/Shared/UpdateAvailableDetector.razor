@inject IJSRuntime _jsRuntime
@inject ILocalLogger logger


@if (_newVersionAvailable)
{
    <Modal 
        Visible=@true
        Title="UPDATE"
        OnOk=@(async () => {await _jsRuntime.InvokeVoidAsync("window.location.reload", null);})
        OnCancel=@(async () => {await _jsRuntime.InvokeVoidAsync("window.location.reload", null);})
        >
        Update Available. The app will be refreshed.
        Whether you like it or not!
    </Modal>
}

@code {

    private bool _newVersionAvailable = false;

    protected override async Task OnInitializedAsync()
    {
        await RegisterForUpdateAvailableNotification();
    }
    private async Task RegisterForUpdateAvailableNotification()
    {
        logger.Log(nameof(RegisterForUpdateAvailableNotification));
        await _jsRuntime.InvokeAsync<object>(
            identifier: "registerForUpdateAvailableNotification",
            DotNetObjectReference.Create(this),
            nameof(OnUpdateAvailable));
    }

    [JSInvokable(nameof(OnUpdateAvailable))]
    public Task OnUpdateAvailable()
    {
        if (!_newVersionAvailable)
        {
            logger.Log("Update available. Show update button!");
            _newVersionAvailable = true;
            StateHasChanged();
        } else
        {
            // nothing
        }


        return Task.CompletedTask;
    }

}