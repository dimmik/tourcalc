@using AntDesign

@inherits LayoutComponentBase
@implements IDisposable

@using TCalcCore.Engine
@inject TourcalcEngine engine

@inject UiModeService uiMode

@inject IJSRuntime JS

@inject NavigationManager NavManager


<div class="page">
@if (engine.Auth == null)
{
   <div class="tcn-splash"><span class="tcn-spin">⟳</span> Checking access…</div>
}
    else
    {

        if (uiMode.IsNew && (LoggingIn || engine.Auth.Type == "None"))
        {
            @* A screen, not a dialog. As a modal it had no close button, no mask click and
               no Esc - once you were logged out there was literally no way out of it, which on
               a phone means force-closing the app. *@
            <div class="tcn-shell">
                <header class="tcn-topbar">
                    <span class="tcn-brand" aria-hidden="true">🧭</span>
                    <div class="tcn-topbar-title">Tourcalc</div>
                    <div class="tcn-topbar-actions">
                        <UiModeSwitch/>
                    </div>
                </header>
                <main class="tcn-main">
                    <div class="tcn-signin">
                        <div class="tcn-signin-card">
                            <div class="tcn-signin-logo">🧭</div>
                            <h1 class="tcn-signin-title">Tourcalc</h1>
                            <p class="tcn-login-lead">Enter the access code for your tour to continue.</p>
                            @if (loginError)
                            {
                                <div class="tcn-errors">Could not log in. Check the code and your connection, then try again.</div>
                            }
                            <div class="tcn-field">
                                <div class="tcn-label">Access code</div>
                                <input class="tcn-input tcn-login-input" type="text" autocomplete="off"
                                       autocapitalize="off" spellcheck="false"
                                       placeholder="your code" disabled=@LoggingIn
                                       @bind-value="code" @bind-value:event="oninput"
                                       @onkeyup=@(async (e) => {
                                           if (e.Code == "Enter" || e.Code == "NumpadEnter") { await LogIn(); }
                                       }) />
                            </div>
                            <button type="button" class="tcn-btn tcn-btn-primary tcn-btn-block"
                                    disabled=@(LoggingIn || string.IsNullOrWhiteSpace(code))
                                    @onclick="LogIn">
                                @if (LoggingIn)
                                {
                                    <span class="tcn-spin">⟳</span>
                                    <span>Logging in…</span>
                                }
                                else
                                {
                                    <span>Log in</span>
                                }
                            </button>
                            <div class="tcn-hint" style="margin-top:12px">
                                No code at hand? Opening a tour link logs you in by itself —
                                ask whoever shares the tour to send it again.
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        }
        else if (!LoggingIn)
        {
            @if (engine.Auth.Type == "None")
            {
                <AntDesign.Modal
                Visible=@true
                Title="Log In"
                Footer=@dummyFooter
                >
                <span><input type="text" @bind-value="code" @onkeyup=@(async (e) => {
                    if (e.Code == "Enter" || e.Code == "NumpadEnter"){
                        await LogIn();
                    }
                })/>
                    <button @onclick="LogIn">Auth</button>
                </span>
                </AntDesign.Modal>
            }
            else if (uiMode.IsNew)
            {
                <div class="tcn-shell">
                    <header class="tcn-topbar">
                        <a class="tcn-brand" href="/tourlist" title="Tour list" aria-label="Tour list">🧭</a>
                        <div class="tcn-topbar-title" @onclick="OnTitleClick" title="@Title">@Title</div>
                        <div class="tcn-topbar-actions">
                            <SyncStatusComponent/>
                            <UpdateAvailableDetector/>
                            <UiModeSwitch/>
                            <a class="tcn-iconbtn" href="/settings" title="Settings" aria-label="Settings">⚙</a>
                            <button type="button"
                                    class="tcn-iconbtn @(engine.Auth.IsMaster ? "tcn-danger" : "")"
                                    title=@(engine.Auth.IsMaster ? "Log out (master)" : "Log out")
                                    aria-label="Log out"
                                    @onclick=@(async () => await LogOut())>⏻</button>
                        </div>
                    </header>
                    <main class="tcn-main">@Body</main>
                </div>
            }
            else
            {
                <Layout >
                    <Header Style="background-color: darkblue; color: white; padding: 4px; display: table; height: 30px; line-height: 30px;">
                        <div style="display: table-cell; align-content: flex-start; width: 65%; text-align: start;">
                            <a class="navbar-brand" style="margin: 3px; padding: 5px;" href="">
                                <span class="oi oi-home" aria-hidden="true"></span>
                            </a>&nbsp;&nbsp;
                            <span style="color:white; font-size: clamp(6px, 4vw, 18px);@(tour == null ? "" : "cursor:pointer;")"
                                @onclick="OnTitleClick">
                                @(Title.Length > 2000 ? $"{Title.Substring(0, 17)}..." : Title)
                            </span>&nbsp;&nbsp;
                            <UiModeSwitch Single="true"/>
                        </div>
                        <div style="display: table-cell; align-content: flex-end; width: 35%; text-align: end;">
                            <span><SyncStatusComponent/></span>
                            <UpdateAvailableDetector/>
                            <span style="cursor:pointer; font-size: clamp(6px, 4vw, 24px); border:0px solid white; @($"{(engine.Auth.IsMaster ? "color:red;" : "")}")"
                                  @onclick=@(async () => {
                                await LogOut();
                                //NavManager.NavigateTo("/tourlist");
                      }) class="fa fa-sign-out"></span>
                            @if (false && engine.Auth.IsMaster) // do not show logs button
                            {
                                <Button OnClick=@(() => NavManager.NavigateTo("/logs"))>Logs</Button>
                            }
                            &nbsp;&nbsp;
                            <a class="navbar-brand" style="margin: 3px; padding: 5px;" href="/settings">⚙</a>
                        </div>
                    </Header>
                    <Content Style="padding: 4px">@Body</Content>
                </Layout>
            }

        }
        else
        {
            <AntDesign.Modal
                Visible=@true
                Title="Logging In"
                Footer=@dummyFooter
                >
                <div style="text-align:center">Logging In...</div>
                </AntDesign.Modal>
        }

}
</div>
<AntContainer/>

@code {
    private string? code;

    private bool LoggingIn = false;
    private bool loginError = false;
    private string Title = "Wait...";
    private Tour? tour = null;

    protected override async Task OnInitializedAsync()
    {
        engine.onMessageReceived += OnMessageReceived;
        uiMode.OnChanged += OnUiModeChanged;
        await uiMode.Init();
        await engine.PickUpAuthInfo();
    }
    public void Dispose()
    {
        engine.onMessageReceived -= OnMessageReceived;
        uiMode.OnChanged -= OnUiModeChanged;
    }
    private void OnUiModeChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await ApplyBodyClass();
            StateHasChanged();
        });
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ApplyBodyClass();
        }
    }
    private async Task ApplyBodyClass()
    {
        try
        {
            await JS.InvokeVoidAsync("tcSetUiMode", uiMode.IsNew);
        }
        catch
        {
            // JS not available (prerender) - the class is cosmetic only
        }
    }
    private Task OnMessageReceived(string type, object payload)
    {
        if (type == "Title")
        {
            Title = payload as string ?? "";
            StateHasChanged();
        }
        if (type == "Tour")
        {
            tour = payload as Tour;
            StateHasChanged();
        }
        return Task.CompletedTask;
    }
    private void OnTitleChange()
    {
        StateHasChanged();
    }
    private void OnTitleClick()
    {
        if (tour != null)
        {
            NavManager.NavigateTo($"/tour/{tour.Id}");
        }
        else
        {
            NavManager.NavigateTo($"/tourlist");
        }
    }
    private async Task LogOut()
    {
        await engine.LogOut();
        StateHasChanged();
    }
    private async Task LogIn()
    {
        LoggingIn = true;
        loginError = false;
        try {
            var scope = "code"; // "admin"
            var c = code;
            var scC = (code ?? "").Split(':');
            if (scC.Length > 1)
            {
                scope = scC[0];
                c = scC[1];
            }
            await engine.LogIn(scope, c);
        }
        catch
        {
            // TODO handle 2022-12-09 - what it is?..
        }
        await engine.RequestClearLocalTourList(reloadFromServer: false);
        LoggingIn = false;
        // still anonymous means the code was not accepted
        loginError = engine.Auth?.Type == "None";
        if (!loginError) code = "";
    }
    RenderFragment dummyFooter =
    @<span></span>
    ;
}
