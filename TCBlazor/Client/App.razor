@using TCalcCore.Engine
@inject TourcalcEngine engine

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        @{
            bool isTransientAccess = routeData.RouteValues.ContainsKey("transientAccessCode");
            if (isTransientAccess)
            {
                <RouteView RouteData="@routeData" DefaultLayout="@typeof(GoToLanding)" />
            }
            else
            {
                <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            }
            }
    </Found>
    <NotFound>
        @* without this the header keeps whatever the previous page put there *@
        @{ engine.SendMessage("Title", "Tourcalc"); engine.SendMessage("Tour", null); }
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <div class="tcn-empty" role="alert">
                <span class="tcn-empty-icon">🧭</span>
                <div class="tcn-empty-title">Nothing at this address</div>
                <div>The link may be outdated. <a href="/tourlist">Go to your tours</a>.</div>
            </div>
        </LayoutView>
    </NotFound>
</Router>
