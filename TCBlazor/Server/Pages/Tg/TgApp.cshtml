@page "/tgapp"
@model TCBlazor.Server.Pages.Tg.TgAppModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Tourcalc</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        body { font-family: system-ui, sans-serif; margin: 0; display: flex; min-height: 100vh;
               align-items: center; justify-content: center; text-align: center; padding: 1.5em; }
        .msg { color: #666; }
    </style>
</head>
<body>
    <div class="msg" id="msg">Открываю…</div>
    <script>
        // The page proves nothing by itself: it hands Telegram's signed initData to the
        // server, which checks it against the bot token and only then says where to go.
        (function () {
            var tg = window.Telegram && window.Telegram.WebApp;
            var msg = document.getElementById('msg');
            if (tg) { tg.ready(); tg.expand(); }

            var tour = new URLSearchParams(location.search).get('tour');
            if (!tg || !tg.initData) {
                msg.textContent = 'Эта страница открывается из Telegram.';
                return;
            }

            fetch('/api/tg/webapp/enter', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ tour: tour, initData: tg.initData })
            }).then(function (r) {
                if (r.status === 401) throw new Error('Telegram не подтвердил, кто ты.');
                if (r.status === 403) throw new Error('Тебя нет в этой поездке. Нажми «Я еду» в чате.');
                if (r.status === 404) throw new Error('Поездка не найдена.');
                if (!r.ok) throw new Error('Не получилось открыть.');
                return r.json();
            }).then(function (d) {
                location.replace(d.url);
            }).catch(function (e) {
                msg.textContent = e.message;
            });
        })();
    </script>
</body>
</html>
