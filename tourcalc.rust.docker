# The Rust port, as one image: the axum server with the Leptos client baked in.
#
# Nothing here is emulated. wasm is the same bytes whatever the machine runs, so the client
# is built once on the build platform; the server is *cross-compiled* to the target
# architecture rather than compiled under QEMU, which is the difference between a couple of
# minutes and most of an hour. Both are possible because every dependency is pure Rust -
# there is no OpenSSL, no BouncyCastle, nothing that needs a C toolchain for the target.
#
# The server is linked against musl, statically, so nothing needs a libc at runtime and the
# image is a binary and its files and nothing else.
#
# It does need a C compiler at *build* time, which it did not when this file was first
# written: the server now talks to MongoDB and to push services, both over TLS, and rustls
# links `ring`, whose core is C and assembly.
#
# Both compilers come from Debian. An earlier version fetched a musl cross-toolchain from
# musl.cc, which works from a desk and did not work from a GitHub runner - that host is one
# person's server and does not answer everybody. A build should not depend on it.
#
# The build image is pinned by digest, in both stages below. `rust:1-bookworm` is moved on
# every Rust release and every Debian update - several times a month - and a new base
# invalidates every cached layer on top of it: the next build compiles every dependency
# for two architectures and for wasm again, seven or eight minutes instead of three,
# whatever the commit changed. Found exactly that way, when a commit touching two source
# files took nine minutes because the tag had moved twenty minutes earlier. Nothing of this
# image reaches the one that ships (that is distroless, with a static binary in it), so
# being a few weeks behind costs nothing.
#
# To move to a newer Rust, replace both lines with the tag's current digest:
#   docker buildx imagetools inspect rust:1-bookworm    # the "Digest:" line
# and expect one long build afterwards.

# ---------------------------------------------------------------------------------------
# The browser side.
# ---------------------------------------------------------------------------------------
# Rust 1.98.1
FROM --platform=$BUILDPLATFORM rust:1-bookworm@sha256:ae1a730a949f727611a5c684e1e26e5a9bb9885b34f65a442744ca8a61c86ca5 AS client

# The exact version this was developed against. Trunk publishes built binaries, and taking
# one is a minute rather than the several `cargo install trunk` spends compiling it.
ARG TRUNK_VERSION=0.21.14

WORKDIR /src

RUN rustup target add wasm32-unknown-unknown \
 && case "$(uname -m)" in \
        x86_64)  TRUNK_ARCH=x86_64 ;; \
        aarch64) TRUNK_ARCH=aarch64 ;; \
        *) echo "no trunk build for $(uname -m)" >&2; exit 1 ;; \
    esac \
 && curl -fsSL "https://github.com/trunk-rs/trunk/releases/download/v${TRUNK_VERSION}/trunk-${TRUNK_ARCH}-unknown-linux-gnu.tar.gz" \
    | tar -xz -C /usr/local/bin trunk \
 && trunk --version

# What follows is in three steps rather than one, and the order is the whole point: each
# `COPY` is a layer, and a layer is rebuilt only when what it copies has changed. Copying
# the tree in one go - which is what this did - meant that changing an icon recompiled six
# hundred crates to put a different PNG in a directory.
#
# 1. the manifests, and the dependencies they name.
COPY rust/Cargo.toml rust/Cargo.lock ./rust/
COPY rust/crates/tc-core/Cargo.toml ./rust/crates/tc-core/
COPY rust/crates/tc-server/Cargo.toml ./rust/crates/tc-server/
COPY rust/crates/tc-web/Cargo.toml ./rust/crates/tc-web/
COPY rust/crates/spike-bare/Cargo.toml ./rust/crates/spike-bare/
COPY rust/crates/spike-dioxus/Cargo.toml ./rust/crates/spike-dioxus/
COPY rust/crates/spike-leptos/Cargo.toml ./rust/crates/spike-leptos/

# Cargo will not look at a workspace whose members are missing, so every member gets an
# empty source file to be going on with. What is built here is everything *except* this
# project: the dependency graph, which changes only when Cargo.lock does.
RUN set -eux; \
    for c in tc-core tc-server tc-web spike-bare spike-dioxus spike-leptos; do \
        mkdir -p "rust/crates/$c/src"; \
    done; \
    : > rust/crates/tc-core/src/lib.rs; \
    : > rust/crates/tc-server/src/lib.rs; \
    for c in tc-server tc-web spike-bare spike-dioxus spike-leptos; do \
        echo 'fn main() {}' > "rust/crates/$c/src/main.rs"; \
    done; \
    cd rust && cargo build --release --locked --target wasm32-unknown-unknown -p tc-web

# 2. this project's own code, compiled against those dependencies.
#
# **The `touch` is not decoration.** `COPY` keeps the modification time the file has in the
# build context, and cargo decides what to rebuild by modification time: a real source file
# that lands looking older than the stub compiled above is one cargo declares up to date,
# and the image is then built from the empty file. Tried it: cargo answered "Finished in
# 0.06s" and kept the stub.
COPY rust/crates/tc-core/src ./rust/crates/tc-core/src
COPY rust/crates/tc-web/src ./rust/crates/tc-web/src
RUN set -eux; \
    find rust/crates -name '*.rs' -exec touch {} +; \
    cd rust && cargo build --release --locked --target wasm32-unknown-unknown -p tc-web

# 3. everything that is not code: the page, the icons, the manifest, the worker - and the
# app's own stylesheets, which the client's index.html pulls straight out of the Blazor
# client because they are shared rather than copied.
#
# Changing any of these re-runs only what is below this line. The wasm above is already
# built, so trunk finds it done and gets on with hashing and copying.
COPY rust/crates/tc-web ./rust/crates/tc-web
COPY TCBlazor/Client/wwwroot/css/ ./TCBlazor/Client/wwwroot/css/

WORKDIR /src/rust/crates/tc-web

# Trunk fetches wasm-bindgen and wasm-opt itself, matching the versions the crates ask for.
RUN trunk build --release \
 && ls -la dist

# ---------------------------------------------------------------------------------------
# The server, cross-compiled.
# ---------------------------------------------------------------------------------------
# Rust 1.98.1
FROM --platform=$BUILDPLATFORM rust:1-bookworm@sha256:ae1a730a949f727611a5c684e1e26e5a9bb9885b34f65a442744ca8a61c86ca5 AS server

ARG TARGETARCH
WORKDIR /src

# What compiles ring's C, per architecture:
#
# * x86_64 - `musl-gcc`, the real thing for the target.
# * aarch64 - the gnu cross-compiler, because Debian ships no aarch64 musl one, *with the
#   target's libc headers*. `gcc-aarch64-linux-gnu` on its own does not bring them, and
#   `--no-install-recommends` keeps it that way - so the compiler reached for the host's
#   /usr/include instead and died on `bits/libc-header-start.h`, which is x86_64 glibc's
#   idea of stdint.h. It is the C *compiler* only: ring's C uses nothing of libc beyond
#   memcpy and memset, and the final link is done by rustc's own `rust-lld` against the musl
#   crt objects rustc ships. Mixing the two that far is ordinary; mixing them further is not.
ENV CC_x86_64_unknown_linux_musl=musl-gcc \
    CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_LINKER=rust-lld \
    CC_aarch64_unknown_linux_musl=aarch64-linux-gnu-gcc \
    CARGO_TARGET_AARCH64_UNKNOWN_LINUX_MUSL_LINKER=rust-lld

RUN case "$TARGETARCH" in \
        amd64) TRIPLE=x86_64-unknown-linux-musl; PACKAGES="musl-tools" ;; \
        arm64) TRIPLE=aarch64-unknown-linux-musl; \
               PACKAGES="gcc-aarch64-linux-gnu libc6-dev-arm64-cross" ;; \
        *) echo "unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac \
 && echo "$TRIPLE" > /triple \
 && rustup target add "$TRIPLE" \
 && apt-get update \
 && apt-get install -y --no-install-recommends $PACKAGES \
 && rm -rf /var/lib/apt/lists/*

# In two steps, for the reason given in the client stage above - and with one more thing
# worth saying here: **this stage never sees the browser client at all**. It compiles
# `tc-core` and `tc-server`, and nothing it produces depends on a stylesheet, an icon or a
# line of `tc-web`. It used to copy the lot, so every change to any of them recompiled a
# server that could not tell the difference.
COPY rust/Cargo.toml rust/Cargo.lock ./rust/
COPY rust/crates/tc-core/Cargo.toml ./rust/crates/tc-core/
COPY rust/crates/tc-server/Cargo.toml ./rust/crates/tc-server/
COPY rust/crates/tc-web/Cargo.toml ./rust/crates/tc-web/
COPY rust/crates/spike-bare/Cargo.toml ./rust/crates/spike-bare/
COPY rust/crates/spike-dioxus/Cargo.toml ./rust/crates/spike-dioxus/
COPY rust/crates/spike-leptos/Cargo.toml ./rust/crates/spike-leptos/

RUN set -eux; \
    for c in tc-core tc-server tc-web spike-bare spike-dioxus spike-leptos; do \
        mkdir -p "rust/crates/$c/src"; \
    done; \
    : > rust/crates/tc-core/src/lib.rs; \
    : > rust/crates/tc-server/src/lib.rs; \
    for c in tc-server tc-web spike-bare spike-dioxus spike-leptos; do \
        echo 'fn main() {}' > "rust/crates/$c/src/main.rs"; \
    done; \
    cd rust && cargo build --profile server --locked -p tc-server --target "$(cat /triple)"

# `--locked` so the image is built from the versions in Cargo.lock and not from whatever has
# been published since. The default features are on - MongoDB and push notifications - which
# is what a deployment runs with. On the `touch`, see the client stage: without it a source
# file that lands with an older date than the stub above is one cargo leaves alone.
COPY rust/crates/tc-core/src ./rust/crates/tc-core/src
COPY rust/crates/tc-server/src ./rust/crates/tc-server/src
RUN set -eux; \
    find rust/crates -name '*.rs' -exec touch {} +; \
    cd rust; \
    cargo build --profile server --locked -p tc-server --target "$(cat /triple)"; \
    cp "target/$(cat /triple)/server/tc-server" /tc-server; \
    ls -la /tc-server

# ---------------------------------------------------------------------------------------
# What actually ships. The binary is static and carries the Mozilla root certificates inside
# it (rustls uses webpki-roots), so the image needs no libc, no CA bundle, no shell and no
# package manager: a binary, the wasm client and a seed file, running as a user that is not
# root.
# ---------------------------------------------------------------------------------------
FROM gcr.io/distroless/static-debian12:nonroot

ARG BUILD_TYPE=na
# Which build this is and what it was built from. Only in the final stage, so stamping a
# build costs nothing: the client and the server are not recompiled for a new label. What
# identifies the *client* is the hash in its file name, which the server reads from the page
# it serves - see `client_asset` in the server's main.rs.
ARG BUILD_ID=dev
ARG BUILD_COMMIT=
LABEL org.opencontainers.image.title="Tourcalc" \
      org.opencontainers.image.description="axum server, Leptos client. Set StorageType=MongoDb to keep anything; without it the seed below is loaded into memory and forgotten on restart." \
      io.containers.autoupdate=registry

WORKDIR /app

COPY --from=server /tc-server /app/tc-server
COPY --from=client /src/rust/crates/tc-web/dist /app/wwwroot

# The tours the server starts with when nothing else is configured. **That store lives in
# memory**: everything written to it is lost when the container stops, and every start
# begins again from this file - so the image ships the repository's test tours to be poked
# at rather than pretending to be a place to keep anything.
#
# A deployment that means to keep anything sets `StorageType=MongoDb` and the three
# `MongoDb*` settings, and then this file is never read.
COPY TCBlazor/Server/inmemory-tours.json /app/seed/inmemory-tours.json

# Read by `config::from_env`, under the names the C# app already uses.
#
# A real deployment must pass its own `AuthPrivateECDSAKey` and `MasterKey`: the key the
# server falls back to is the development one from appsettings.json, which is in the
# repository and therefore known to everybody.
ENV InMemoryFileName=/app/seed/inmemory-tours.json \
    StaticFilesDir=/app/wwwroot \
    Listen=0.0.0.0:8080 \
    BUILD_TYPE=${BUILD_TYPE} \
    BUILD_ID=${BUILD_ID} \
    BUILD_COMMIT=${BUILD_COMMIT}

EXPOSE 8080

ENTRYPOINT ["/app/tc-server"]
