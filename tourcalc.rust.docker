# The Rust port, as one image: the axum server with the Leptos client baked in.
#
# Nothing here is emulated. wasm is the same bytes whatever the machine runs, so the client
# is built once on the build platform; the server is *cross-compiled* to the target
# architecture rather than compiled under QEMU, which is the difference between a couple of
# minutes and most of an hour. Both are possible because every dependency is pure Rust -
# there is no OpenSSL, no BouncyCastle, nothing that needs a C toolchain for the target.
#
# The server is linked against musl, statically, so nothing needs a libc at runtime and the
# image is a binary and its files and nothing else.
#
# It does need a C compiler at *build* time, which it did not when this file was first
# written: the server now talks to MongoDB and to push services, both over TLS, and rustls
# links `ring`, whose core is C and assembly.
#
# Both compilers come from Debian. An earlier version fetched a musl cross-toolchain from
# musl.cc, which works from a desk and did not work from a GitHub runner - that host is one
# person's server and does not answer everybody. A build should not depend on it.

# ---------------------------------------------------------------------------------------
# The browser side.
# ---------------------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM rust:1-bookworm AS client

# The exact version this was developed against. Trunk publishes built binaries, and taking
# one is a minute rather than the several `cargo install trunk` spends compiling it.
ARG TRUNK_VERSION=0.21.14

WORKDIR /src

RUN rustup target add wasm32-unknown-unknown \
 && case "$(uname -m)" in \
        x86_64)  TRUNK_ARCH=x86_64 ;; \
        aarch64) TRUNK_ARCH=aarch64 ;; \
        *) echo "no trunk build for $(uname -m)" >&2; exit 1 ;; \
    esac \
 && curl -fsSL "https://github.com/trunk-rs/trunk/releases/download/v${TRUNK_VERSION}/trunk-${TRUNK_ARCH}-unknown-linux-gnu.tar.gz" \
    | tar -xz -C /usr/local/bin trunk \
 && trunk --version

# The client's index.html pulls the app's own stylesheets straight out of the Blazor client -
# they are shared, not copied - so they have to be here too. The whole directory rather than
# the files by name: naming them meant that adding the small interface's stylesheet built
# perfectly here and failed in CI, where nothing else in the tree exists.
COPY rust/ ./rust/
COPY TCBlazor/Client/wwwroot/css/ ./TCBlazor/Client/wwwroot/css/

WORKDIR /src/rust/crates/tc-web

# Trunk fetches wasm-bindgen and wasm-opt itself, matching the versions the crates ask for.
RUN trunk build --release \
 && ls -la dist

# ---------------------------------------------------------------------------------------
# The server, cross-compiled.
# ---------------------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM rust:1-bookworm AS server

ARG TARGETARCH
WORKDIR /src

# What compiles ring's C, per architecture:
#
# * x86_64 - `musl-gcc`, the real thing for the target.
# * aarch64 - the gnu cross-compiler, because Debian ships no aarch64 musl one, *with the
#   target's libc headers*. `gcc-aarch64-linux-gnu` on its own does not bring them, and
#   `--no-install-recommends` keeps it that way - so the compiler reached for the host's
#   /usr/include instead and died on `bits/libc-header-start.h`, which is x86_64 glibc's
#   idea of stdint.h. It is the C *compiler* only: ring's C uses nothing of libc beyond
#   memcpy and memset, and the final link is done by rustc's own `rust-lld` against the musl
#   crt objects rustc ships. Mixing the two that far is ordinary; mixing them further is not.
ENV CC_x86_64_unknown_linux_musl=musl-gcc \
    CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_LINKER=rust-lld \
    CC_aarch64_unknown_linux_musl=aarch64-linux-gnu-gcc \
    CARGO_TARGET_AARCH64_UNKNOWN_LINUX_MUSL_LINKER=rust-lld

RUN case "$TARGETARCH" in \
        amd64) TRIPLE=x86_64-unknown-linux-musl; PACKAGES="musl-tools" ;; \
        arm64) TRIPLE=aarch64-unknown-linux-musl; \
               PACKAGES="gcc-aarch64-linux-gnu libc6-dev-arm64-cross" ;; \
        *) echo "unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac \
 && echo "$TRIPLE" > /triple \
 && rustup target add "$TRIPLE" \
 && apt-get update \
 && apt-get install -y --no-install-recommends $PACKAGES \
 && rm -rf /var/lib/apt/lists/*

COPY rust/ ./rust/

# `--locked` so the image is built from the versions in Cargo.lock and not from whatever has
# been published since. The default features are on - MongoDB and push notifications - which
# is what a deployment runs with.
RUN cd rust \
 && cargo build --release --locked -p tc-server --target "$(cat /triple)" \
 && cp "target/$(cat /triple)/release/tc-server" /tc-server \
 && ls -la /tc-server

# ---------------------------------------------------------------------------------------
# What actually ships. The binary is static and carries the Mozilla root certificates inside
# it (rustls uses webpki-roots), so the image needs no libc, no CA bundle, no shell and no
# package manager: a binary, the wasm client and a seed file, running as a user that is not
# root.
# ---------------------------------------------------------------------------------------
FROM gcr.io/distroless/static-debian12:nonroot

ARG BUILD_TYPE=na
# Which build this is and what it was built from. Only in the final stage, so stamping a
# build costs nothing: the client and the server are not recompiled for a new label. What
# identifies the *client* is the hash in its file name, which the server reads from the page
# it serves - see `client_asset` in the server's main.rs.
ARG BUILD_ID=dev
ARG BUILD_COMMIT=
LABEL org.opencontainers.image.title="Tourcalc (Rust experiment)" \
      org.opencontainers.image.description="The Rust port: axum server, Leptos client. Storage is in memory - see InMemoryFileName." \
      io.containers.autoupdate=registry

WORKDIR /app

COPY --from=server /tc-server /app/tc-server
COPY --from=client /src/rust/crates/tc-web/dist /app/wwwroot

# The tours the server starts with. **This store lives in memory**: everything written to it
# is lost when the container stops, and every start begins again from this file. That is the
# state of the port - a database is phase 7 - so the image ships the repository's test tours
# to be poked at rather than pretending to be a place to keep anything.
COPY TCBlazor/Server/inmemory-tours.json /app/seed/inmemory-tours.json

# Read by `config::from_env`, under the names the C# app already uses.
#
# A real deployment must pass its own `AuthPrivateECDSAKey` and `MasterKey`: the key the
# server falls back to is the development one from appsettings.json, which is in the
# repository and therefore known to everybody.
ENV InMemoryFileName=/app/seed/inmemory-tours.json \
    StaticFilesDir=/app/wwwroot \
    Listen=0.0.0.0:8080 \
    BUILD_TYPE=${BUILD_TYPE} \
    BUILD_ID=${BUILD_ID} \
    BUILD_COMMIT=${BUILD_COMMIT}

EXPOSE 8080

ENTRYPOINT ["/app/tc-server"]
