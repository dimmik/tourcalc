<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Takes the numbers the C# implementation produces and writes them down, so the Rust
    port can be checked against the thing it replaces instead of against a transcription
    of a screenshot. Run once per change to the fixtures; the output is committed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>GoldenDump</AssemblyName>
    <RootNamespace>GoldenDump</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.0.1" />
    <PackageReference Include="BouncyCastle.NetCore" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\TCalcCore\TCalcCore.csproj" />
    <Compile Include="..\..\..\TCBlazor\Server\Auth\ECDSAKey.cs" Link="ECDSAKey.cs" />
    <Compile Include="..\..\..\TCBlazor\Server\Auth\IECDsaCryptoKey.cs" Link="IECDsaCryptoKey.cs" />
    <Compile Include="..\..\..\TCBlazor\Server\Auth\ECDsaPublicKey.cs" Link="ECDsaPublicKey.cs" />
  </ItemGroup>

</Project>
