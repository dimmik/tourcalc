# alpine rather than the Debian image: the base is about a hundred megabytes lighter, and
# the app still runs as root on port 80, so nothing about the deployment changes.
#
# The Debian image ships ICU; the alpine one does not, and .NET on it starts in
# globalization-invariant mode - which would quietly change how anything culture-aware is
# compared, parsed and formatted. Putting ICU back takes all three of these: the packages,
# and the switch that tells the runtime to stop being invariant. icu-data-full is the bulk
# of it (~30 MB) and carries the cultures beyond en-US/en-GB that icu-libs alone has.
# Recipe from dotnet/dotnet-docker, samples/aspnetapp/Dockerfile.alpine-icu.
FROM  mcr.microsoft.com/dotnet/aspnet:8.0-alpine AS base
RUN apk add --no-cache icu-data-full icu-libs tzdata
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false \
    LC_ALL=en_US.UTF-8 \
    LANG=en_US.UTF-8
WORKDIR /app
#RUN dotnet --version
#ENV ASPNETCORE_HTTP_PORTS=80
ENV ASPNETCORE_URLS=http://*:80
EXPOSE 80
EXPOSE 443



#### Build and publish backend (on linux/amd64 for performance reasons)
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:8.0 AS publishtc
ARG BUILD_TYPE=na
ARG BUILD_PROPS=""
WORKDIR /src
COPY . .

# for tourcalc.run.docker only. DO NOT copy to tourcalc.docker (that is basically for build by ci/cd)
# replace buildnum and buildver
RUN export TZ='Europe/Moscow' && export DT="$(date +"%Y%m%d-%H%M%S")" && grep -Irl "#{Build.BuildNumber}#" . | xargs sed -i 's/#{Build.BuildNumber}#/'$DT'/g'
RUN grep -Irl "#{Build.SourceBranch}#" . | xargs sed -i 's/#{Build.SourceBranch}#/local/g'
RUN grep -Irl '#{BuildType}#' . | xargs sed -i "s/#{BuildType}#/${BUILD_TYPE}/g"

# The wasm-tools workload (and the python3 emscripten needs) was here for AOT only, and AOT
# is off: it is a speed optimisation that costs tens of megabytes, and this client adds up
# a few dozen numbers. Bring both back if RunAOTCompilation ever returns.
WORKDIR "/src/TCBlazor/Server"
RUN export TZ='Europe/Moscow' && export DT="$(date +"%Y%m%d-%H%M%S")" && dotnet publish -m --version-suffix $DT "TCBlazor.Server.csproj" -c Release $BUILD_PROPS -o /app 

# What a running app has no use for. Done here, before the COPY, so none of it ever lands
# in a layer of the final image.
#   BlazorDebugProxy  - the WASM debugger, 11 MB, published even in Release
#   AntDesign css     - ten themes ship, index.html links one (see service-worker.published.js,
#                       which is told to skip the other nine so the cache stays consistent)
#   AntDesign less    - the stylesheet sources, 1 MB, of no use at runtime
#   .br / .gz         - nothing serves pre-compressed files: no ResponseCompression, no
#                       content-encoding mapping, and they are not in the assets manifest
RUN rm -rf /app/BlazorDebugProxy \
 && find /app/wwwroot/_content/AntDesign/css -type f ! -name 'ant-design-blazor.css' -delete \
 && rm -rf /app/wwwroot/_content/AntDesign/less \
 && find /app/wwwroot/_framework \( -name '*.br' -o -name '*.gz' \) -delete \
 && du -sh /app

FROM base AS final
WORKDIR /app
COPY --from=publishtc /app .


RUN export TZ='Europe/Moscow' && date +"%Y-%m-%d %H:%M:%S"

#RUN ls -Rla /app
ENTRYPOINT ["dotnet", "TCBlazor.Server.dll"]

### README
